In 9.2p1 hostaddr has static storage and cinfo survives ssh_session2.
The lowercase hostname alone is freed by ssh_login after authentication.

--- a/sshconnect2.c
+++ b/sshconnect2.c
@@ -229,3 +229,3 @@
-	xxx_host = host;
+	xxx_host = xstrdup(host);
 	xxx_hostaddr = hostaddr;
