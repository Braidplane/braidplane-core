package views

templ AuthErrorPage(title string, message string, returnTo string) {
	@AuthPage(title, false, AuthErrorPageContent(message, returnTo))
}

templ AuthErrorPageContent(message string, returnTo string) {
	<div class="space-y-5 text-center">
		<h1 class="text-2xl font-semibold">Authentication failed</h1>
		<div data-form-feedback>
			@FormError("auth-error-feedback", message, true)
		</div>
		<a class="btn btn-primary w-full" href={ templ.URL(AuthReturnURL("/auth/login", returnTo)) }>Back to sign in</a>
	</div>
}
