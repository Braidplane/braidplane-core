package views

templ ResetPasswordPage(title string, pageError string, pageErrorDetails string, successMessage string) {
	@AuthPage(title, true, ResetPasswordPageContent(pageError, pageErrorDetails, successMessage))
}

templ ResetPasswordPageContent(pageError string, pageErrorDetails string, successMessage string) {
	<div class="space-y-5">
		<header>
			<p class="text-xs font-semibold uppercase tracking-wide text-primary">Account recovery</p>
			<h1 class="mt-2 text-2xl font-semibold">Reset password</h1>
			<p class="mt-2 text-sm text-base-content/70">Enter the code from your email and choose a new password.</p>
		</header>
		if successMessage != "" {
			<div class="alert alert-success text-sm" role="status">{ successMessage }</div>
			<a class="btn btn-primary w-full" href="/auth/login">Go to sign in</a>
		} else {
			<form class="space-y-3" hx-history="false" method="post" action="/auth/reset-password" hx-post="/auth/reset-password" hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" data-form-feedback>
				<label class="form-control w-full">
					<span class="label-text">Reset code</span>
					<input class="input input-bordered w-full" type="text" name="token" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" required/>
				</label>
				@authNewPasswordField("New password")
				<label class="form-control w-full">
					<div class="label">
						<span class="label-text">Confirm password</span>
					</div>
					<input class="input input-bordered w-full" type="password" name="confirm_password" placeholder="••••••••••••" autocomplete="new-password" minlength="8" required/>
				</label>
				@FormError("reset-password-feedback", pageError, true)
				if pageErrorDetails != "" {
					<details class="text-sm"><summary>More details</summary><p class="whitespace-pre-wrap break-words">{ pageErrorDetails }</p></details>
				}
				@FormRequestError()
				<button class="btn btn-primary w-full" type="submit">Reset password</button>
			</form>
		}
		<p class="text-center text-sm text-base-content/70">
			<a class="link link-primary" href="/auth/login">Back to sign in</a>
			<a class="link link-primary" href="/auth/forgot-password">Request a new reset code</a>
		</p>
	</div>
}
