package views

templ ResetPasswordPage(title string, token string, pageError string, pageErrorDetails string, successMessage string) {
	@AuthPage(title, true, ResetPasswordPageContent(token, pageError, pageErrorDetails, successMessage))
}

templ ResetPasswordPageContent(token string, pageError string, pageErrorDetails string, successMessage string) {
	if pageError != "" {
		@ErrorPopup("reset-password-error-popup", pageError, pageErrorDetails)
	}
	<div class="space-y-5">
		<header>
			<p class="text-xs font-semibold uppercase tracking-wide text-primary">Account recovery</p>
			<h1 class="mt-2 text-2xl font-semibold">Reset password</h1>
			<p class="mt-2 text-sm text-base-content/70">Set a new password for your account.</p>
		</header>
		if successMessage != "" {
			<div class="alert alert-success text-sm">{ successMessage }</div>
			<a class="btn btn-primary w-full" href="/auth/login">Go to sign in</a>
		} else {
			<form class="space-y-3" method="post" action="/auth/reset-password" hx-post="/auth/reset-password" hx-target="main" hx-select="main" hx-swap="innerHTML">
				<input type="hidden" name="token" value={ token }/>
				<label class="form-control w-full">
					<div class="label">
						<span class="label-text">New password</span>
					</div>
					<input class="input input-bordered w-full" type="password" name="password" placeholder="••••••••••••"/>
				</label>
				<label class="form-control w-full">
					<div class="label">
						<span class="label-text">Confirm password</span>
					</div>
					<input class="input input-bordered w-full" type="password" name="confirm_password" placeholder="••••••••••••"/>
				</label>
				<button class="btn btn-primary w-full" type="submit">Reset password</button>
			</form>
		}
		<p class="text-center text-sm text-base-content/70">
			<a class="link link-primary" href="/auth/login">Back to sign in</a>
		</p>
	</div>
}
