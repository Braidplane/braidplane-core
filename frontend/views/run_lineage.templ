package views

import (
	"fmt"
	"strings"

	api "github.com/Braidplane/braidplane-core/api-schema/gen/client"
	"github.com/Braidplane/braidplane-core/frontend/runlineage"
)

templ PipelineRunLineageWorkbench(
	orgSlug string,
	activeProjectSlug string,
	environmentSlug string,
	run api.PipelineRunRecord,
	lineage runlineage.View,
	embedded bool,
) {
	<section
		id="run-lineage"
		class={ func() string {
			if embedded {
				return "mt-4 border-t border-base-300 pt-4"
			}
			return "mt-6 rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm sm:p-5"
		}() }
		aria-labelledby="run-lineage-heading"
	>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 id="run-lineage-heading" class="text-base font-semibold text-base-content">Run lineage</h2>
				<p class="mt-1 text-sm text-base-content/65">
					if embedded {
						Execution trail in dependency order.
					} else {
						Exact pipeline version topology with observed step evidence from this run.
					}
				</p>
			</div>
			if embedded && lineage.Available && lineage.VersionShortHash != "" {
				<span class="badge badge-ghost font-mono text-[0.65rem]">version { lineage.VersionShortHash }</span>
			}
		</div>
		if !lineage.Available {
			<div class="mt-3 rounded-lg border border-base-300 bg-base-200/50 px-4 py-3">
				<p class="text-sm font-medium text-base-content">Execution topology unavailable</p>
				if lineage.Message != "" {
					<p class="mt-1 text-xs text-base-content/65">{ lineage.Message }</p>
				}
				<p class="mt-1 text-xs text-base-content/65">The execution timeline remains available in Steps.</p>
			</div>
		} else if len(lineage.Nodes) == 0 {
			<div class="mt-3 text-sm">The executed pipeline version contains no steps.</div>
		} else if embedded {
			@PipelineRunLineageCompact(lineage)
			<div class="mt-3">
				<a
					class="btn btn-outline btn-sm w-full"
					href={ templ.URL(buildEnvironmentRunDetailHref(orgSlug, activeProjectSlug, environmentSlug, string(run.Metadata.RunSlug)) + "#run-lineage") }
				>
					Open full lineage
				</a>
			</div>
		} else {
			<div id="pipeline-run-lineage-workbench" class="mt-4 grid min-w-0 grid-cols-1 gap-4">
				@PipelineRunLineageGraph(orgSlug, activeProjectSlug, environmentSlug, run, lineage)
				<div class="min-w-0 space-y-4">
					@PipelineRunLineageEvidence(lineage)
				</div>
				if len(lineage.Edges) > 0 {
					<ul class="sr-only" aria-label="Lineage dependencies">
						for _, edge := range lineage.Edges {
							<li>{ lineageDependencyLabel(edge) }</li>
						}
					</ul>
				}
			</div>
		}
	</section>
}

templ PipelineRunLineageLegend(lineage runlineage.View) {
	<div class="grid grid-cols-3 overflow-hidden rounded-xl border border-base-300 bg-base-100" aria-label="Pipeline stages">
		<div class="border-r border-base-300 px-3 py-2.5">
			<div class="flex items-center gap-2">
				<span class={ lineageKindDotClass("query") }></span>
				<span class="text-xs font-semibold text-base-content">Source</span>
				<span class="ml-auto text-xs tabular-nums text-base-content/50">{ fmt.Sprintf("%d", lineageKindCount(lineage.Nodes, "query")) }</span>
			</div>
			<p class="mt-1 text-[0.68rem] text-base-content/55">Reads from a data source</p>
		</div>
		<div class="border-r border-base-300 px-3 py-2.5">
			<div class="flex items-center gap-2">
				<span class={ lineageKindDotClass("transform") }></span>
				<span class="text-xs font-semibold text-base-content">Transform</span>
				<span class="ml-auto text-xs tabular-nums text-base-content/50">{ fmt.Sprintf("%d", lineageKindCount(lineage.Nodes, "transform")) }</span>
			</div>
			<p class="mt-1 text-[0.68rem] text-base-content/55">Reshapes upstream payloads</p>
		</div>
		<div class="px-3 py-2.5">
			<div class="flex items-center gap-2">
				<span class={ lineageKindDotClass("sink") }></span>
				<span class="text-xs font-semibold text-base-content">Sink</span>
				<span class="ml-auto text-xs tabular-nums text-base-content/50">{ fmt.Sprintf("%d", lineageKindCount(lineage.Nodes, "sink")) }</span>
			</div>
			<p class="mt-1 text-[0.68rem] text-base-content/55">Delivers to a destination</p>
		</div>
	</div>
	<p class="mt-2 text-xs text-base-content/55">
		Select a step or dependency to inspect its recorded evidence. Raw payload values are not stored.
	</p>
}

templ PipelineRunLineageFactGroup(title string, facts []lineageEvidenceFact) {
	<section class="rounded-lg border border-base-300 bg-base-200/30 px-3 py-2.5">
		<h4 class="text-[0.68rem] font-semibold uppercase tracking-wide text-base-content/55">{ title }</h4>
		<dl class="mt-2 grid gap-2 text-xs">
			for _, fact := range facts {
				<div>
					<dt class="text-base-content/50">{ fact.Label }</dt>
					<dd class="mt-0.5 break-words text-base-content">{ fact.Value }</dd>
				</div>
			}
		</dl>
	</section>
}

templ lineageStatusBadge(node runlineage.Node) {
	<span class={ lineageStatusBadgeClass(node.Status) }>
		if node.Status == runlineage.StatusRunning {
			<span class="loading loading-spinner size-3 motion-reduce:animate-none" aria-hidden="true"></span>
		} else if node.Status == runlineage.StatusSucceeded {
			<svg class="size-3 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 8 3 3 7-7"></path></svg>
		} else if node.Status == runlineage.StatusPending {
			<svg class="size-3 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="5"></circle></svg>
		} else if node.Status == runlineage.StatusFailed {
			<svg class="size-3 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8"></path></svg>
		}
		{ lineageNodeStatusLabel(node) }
	</span>
}

templ PipelineRunLineageCompact(lineage runlineage.View) {
	<ol class="mt-3 max-h-[28rem] space-y-2 overflow-y-auto pr-1" aria-label="Run lineage steps">
		for _, node := range lineage.Nodes {
			<li class="relative">
				<div class={ lineageCompactNodeClass(node) }>
					<div class="flex items-start justify-between gap-3">
						<div class="min-w-0">
							<div class="flex flex-wrap items-center gap-2">
								<span class={ lineageKindBadgeClass(node.Kind) }>{ lineageKindLabel(node.Kind) }</span>
								@lineageStatusBadge(node)
							</div>
							<a class="mt-2 block truncate text-sm font-semibold link link-primary" data-entity-focus="lineage-step-evidence" href={ templ.URL(node.Href) } aria-current={ func() string { if node.Selected { return "true" }; return "false" }() }>{ lineageStepName(node) }</a>
							<p class="mt-1 truncate font-mono text-[0.68rem] text-base-content/60">{ node.Slug }</p>
						</div>
						if node.DurationMs > 0 {
							<span class="shrink-0 text-xs tabular-nums text-base-content/60">{ lineageDurationLabel(node) }</span>
						}
					</div>
					<p class="mt-2 text-xs text-base-content/60">{ lineageNodeDependencies(node) }</p>
					if node.Snapshot != nil {
						<p class="mt-1 text-xs text-base-content/75">{ lineageOutputLabel(node.Snapshot) }</p>
					}
				</div>
			</li>
		}
	</ol>
}

templ PipelineRunLineageEvidence(lineage runlineage.View) {
	{{ node := lineageSelectedNode(lineage) }}
	<aside id="lineage-step-evidence" tabindex="-1" class="rounded-xl border border-base-300 bg-base-100 p-4 2xl:sticky 2xl:top-4 2xl:self-start" aria-label="Selected step evidence">
		if node == nil {
			if requested := entityPageURL(ctx).Query().Get("lineage_step"); requested != "" {
				<p class="text-sm text-base-content/65">Step { requested } is unavailable in this executed definition.</p>
			} else {
				<p class="text-sm text-base-content/65">Select a step to inspect its execution evidence.</p>
			}
		} else {
			<div class="flex flex-wrap items-center gap-2">
				<span class={ lineageKindBadgeClass(node.Kind) }>{ lineageKindLabel(node.Kind) }</span>
				@lineageStatusBadge(*node)
			</div>
			<h3 class="mt-3 text-lg font-semibold text-base-content">{ lineageStepName(*node) }</h3>
			<p class="mt-1 break-all font-mono text-xs text-base-content/60">{ node.Slug }</p>
			<p class="mt-2 text-xs text-base-content/55">Sanitized payload metadata; raw values are not stored.</p>
			if node.FailedCheck != nil && node.Failure == nil {
				<p class="mt-3 text-sm font-semibold text-error">Recorded contract check failed · { node.Boundary } boundary</p>
				<p class="mt-1 text-sm text-error">{ runContractFailureSummary(node.FailedCheck.ContractFailure) }</p>
				<p class="mt-1 text-xs text-base-content/70">No step-level failure diagnostic was recorded.</p>
			}
			if node.Failure != nil {
				<div class="mt-4 border-t border-error/40 pt-3">
					<p class="text-sm font-semibold text-error">
						Failure · { failureSideLabel(string(node.Failure.Side)) }
						if node.Boundary != "" {
							<span>· { node.Boundary } boundary</span>
						}
					</p>
					if node.FailureInput != "" {
						<p class="text-sm">Input: { node.FailureInput }</p>
					}
					@PipelineRunFailureDiagnostic(node.Failure)
					if node.Boundary == "" {
						<p class="text-xs text-base-content/70">The recorded evidence does not identify a specific input or output boundary.</p>
					}
				</div>
			}
			<a class="btn btn-outline btn-sm mt-3" href={ templ.URL(DefinitionHref(node.Href, node.Slug, node.FailureInput, node.Boundary, "structured")) }>{ lineageDefinitionActionLabel(*node) }</a>
			{{ actions := runStepActions(ctx) }}
			if actions.DataSourceHref != "" || actions.QueryHref != "" || actions.PipelineHref != "" {
				<div class="mt-3 flex flex-wrap gap-3 text-sm" aria-label="Current configuration">
					if actions.PipelineHref != "" {
						<a class="btn btn-outline btn-sm" href={ templ.URL(entityDetailHref(actions.PipelineHref, node.Href)) }>Edit current pipeline in Builder</a>
					}
					if actions.DataSourceHref != "" {
						<a class="btn btn-outline btn-sm" href={ templ.URL(entityDetailHref(actions.DataSourceHref, node.Href)) }>Review current connection</a>
					}
					if actions.QueryHref != "" {
						<a class="btn btn-outline btn-sm" href={ templ.URL(entityDetailHref(actions.QueryHref, node.Href)) }>Review current saved query</a>
					}
				</div>
				<p class="mt-1 text-xs text-base-content/70">Current editable configuration may differ from this immutable execution.</p>
			}
			if actions.Message != "" {
				<p class="mt-2 text-xs text-base-content/70">{ actions.Message }</p>
			}
			<dl class="mt-4 grid gap-3 text-sm">
				<div>
					<dt class="text-xs uppercase tracking-wide text-base-content/55">Depends on</dt>
					<dd class="mt-1 break-words text-base-content">{ lineageNodeDependencies(*node) }</dd>
				</div>
				<div>
					<dt class="text-xs uppercase tracking-wide text-base-content/55">Duration</dt>
					<dd class="mt-1 text-base-content">{ lineageDurationLabel(*node) }</dd>
				</div>
				if node.Incremental != nil {
					<div>
						<dt class="text-xs uppercase tracking-wide text-base-content/55">Checkpoint</dt>
						<dd class="mt-1 break-words text-base-content">{ string(node.Incremental.CommitResult.Status) }</dd>
					</div>
				}
			</dl>
			<div class="mt-4 space-y-3">
				<details>
					<summary class="cursor-pointer text-xs">Executed configuration</summary>
					@PipelineRunLineageFactGroup("Planned step", lineagePlannedFacts(*node))
				</details>
				@PipelineRunLineageFactGroup("Observed run", lineageObservedFacts(*node))
			</div>
			if node.Blocked {
				<p class="mt-3 text-sm">Not executed: blocked by a failed dependency.</p>
			}
			if node.Status == runlineage.StatusUnknown {
				<div class="mt-4 rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-xs text-base-content">
					This run is terminal, but persisted step events do not prove this step's outcome.
				</div>
			}
		}
	</aside>
}

templ PipelineRunLineageGraph(orgSlug string, activeProjectSlug string, environmentSlug string, run api.PipelineRunRecord, lineage runlineage.View) {
	<div class="min-w-0">
		<div class="lg:hidden">
			@PipelineRunLineageCompact(lineage)
		</div>
		<div class="hidden lg:block" data-lineage-view={ buildEnvironmentRunDetailHref(orgSlug, activeProjectSlug, environmentSlug, string(run.Metadata.RunSlug)) + "|" + lineage.VersionHash }>
			@PipelineRunLineageLegend(lineage)
			<div class="mt-3">
				<div class="min-w-0">
					<div class="flex flex-wrap items-center justify-between gap-2 rounded-t-xl border border-b-0 border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/60">
						<span>Solid: payload flow · Dashed: parameter reference</span>
						<div class="flex flex-wrap items-center gap-1" role="group" aria-label="Lineage view controls">
							<button type="button" class="btn btn-ghost btn-xs" data-lineage-action="out" aria-label="Zoom out">−</button>
							<output class="w-12 text-center tabular-nums" data-lineage-zoom aria-live="polite" aria-label="Current zoom">100%</output>
							<button type="button" class="btn btn-ghost btn-xs" data-lineage-action="in" aria-label="Zoom in">+</button>
							<button type="button" class="btn btn-ghost btn-xs" data-lineage-action="fit" aria-pressed="true">Fit</button>
							<button type="button" class="btn btn-ghost btn-xs" data-lineage-action="reset">100%</button>
						</div>
						<span>Drag background or scroll to pan · + / − to zoom · 0 to fit</span>
					</div>
					<div
						data-lineage-viewport
						class="pipeline-graph-grid relative h-[32rem] min-w-0 overflow-auto rounded-b-xl border border-base-300 bg-base-200/35 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
						tabindex="0"
						role="region"
						aria-label="Run lineage graph"
					>
						<div data-lineage-bounds class="relative overflow-hidden" style={ templ.SafeCSS(fmt.Sprintf("width:%dpx;height:%dpx;", lineage.CanvasWidth, lineage.CanvasHeight)) }>
							<div
								data-lineage-canvas
								class="absolute origin-top-left"
								style={ templ.SafeCSS(fmt.Sprintf("width:%dpx;height:%dpx;", lineage.CanvasWidth, lineage.CanvasHeight)) }
							>
								<svg
									class="pointer-events-none absolute inset-0 z-0"
									width={ fmt.Sprintf("%d", lineage.CanvasWidth) }
									height={ fmt.Sprintf("%d", lineage.CanvasHeight) }
									viewBox={ fmt.Sprintf("0 0 %d %d", lineage.CanvasWidth, lineage.CanvasHeight) }
									aria-hidden="true"
								>
									for _, edge := range lineage.Edges {
										<path
											class={ lineageEdgeClass(edge) }
											d={ edge.Path }
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-dasharray={ func() string {
													if edge.Dashed {
														return "6 6"
													}
													return ""
												}() }
										></path>
										<polygon class={ lineageEdgeClass(edge) } points={ edge.ArrowPoints } fill="currentColor"></polygon>
									}
								</svg>
								for _, edge := range lineage.Edges {
									<a
										href={ templ.URL(edge.Href) }
										aria-label={ lineageDependencyLabel(edge) }
										class={ lineageEdgeLabelClass(edge) }
										style={ templ.SafeCSS(fmt.Sprintf("left:%dpx;top:%dpx;transform:translate(-50%%,-50%%);", edge.LabelX, edge.LabelY)) }
									>
										{ edge.Label }
									</a>
								}
								for _, node := range lineage.Nodes {
									<div
										class="absolute z-10"
										style={ templ.SafeCSS(fmt.Sprintf("left:%dpx;top:%dpx;width:208px;height:116px;", node.X, node.Y)) }
									>
										<a
											class={ lineageNodeClass(node) }
											data-entity-focus="lineage-step-evidence"
											href={ templ.URL(node.Href) }
											title={ lineagePayloadPreview(node) }
											aria-label={ lineageNodeAriaLabel(node) }
											if node.Selected {
												aria-current="true"
											}
										>
											<span class={ lineageKindRailClass(node.Kind) }></span>
											<span class="block px-3 py-2.5">
												<span class="flex items-center justify-between gap-2">
													<span class={ lineageKindBadgeClass(node.Kind) }>{ lineageKindLabel(node.Kind) }</span>
													@lineageStatusBadge(node)
												</span>
												<span class="mt-2 block truncate text-sm font-semibold text-base-content">{ lineageStepName(node) }</span>
												<span class="mt-1 block truncate font-mono text-[0.68rem] text-base-content/60">{ node.Slug }</span>
												<span class="mt-1 flex items-center justify-between gap-2 text-xs text-base-content/65">
													if node.Boundary != "" {
														<span class="font-semibold text-error">Failed { node.Boundary }</span>
													} else {
														<span>{ lineageDurationLabel(node) }</span>
													}
													if node.Snapshot != nil {
														<span class="min-w-0 truncate text-right">{ lineageOutputLabel(node.Snapshot) }</span>
													}
												</span>
											</span>
										</a>
										if len(node.Upstream) > 0 {
											<span class={ lineagePortClass(node, "input") } role="img" aria-label={ lineagePortLabel(node, "input") }>◀</span>
										}
										if len(node.Downstream) > 0 {
											<span class={ lineagePortClass(node, "output") } role="img" aria-label={ lineagePortLabel(node, "output") }>▶</span>
										}
									</div>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// Retained safe diagnostics must not disappear behind a generic reason-code label.
templ PipelineRunFailureDiagnostic(failure *api.PipelineRunFailureContext) {
	<p class="mt-2 break-words text-sm text-error">{ runFailureSummary(failure) }</p>
	if hint := runFailureActionHint(failure); hint != "" {
		<p class="mt-2 text-sm">{ hint }</p>
	}
	<details class="mt-2 min-w-0">
		<summary class="cursor-pointer text-xs">Technical diagnostic</summary>
		if diagnostic := strings.TrimSpace(failure.Error); diagnostic != "" && diagnostic != runFailureSummary(failure) {
			<p class="mt-2 break-words text-xs">{ diagnostic }</p>
		}
		if failure.Contract != nil {
			if failure.Contract.ContractName != "" {
				<p class="text-xs">Contract: { failure.Contract.ContractName }</p>
			}
			<p class="text-xs">Violations: { fmt.Sprint(failure.Contract.ViolationCount) } · { failure.Contract.ReasonCode }</p>
		}
		if failure.ReasonCode != nil {
			<p class="mt-1 break-words font-mono text-xs">{ string(*failure.ReasonCode) }</p>
		}
	</details>
}
