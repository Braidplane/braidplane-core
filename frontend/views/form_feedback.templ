package views

templ FormError(id string, message string, focusSummary bool) {
	if message != "" {
		<div id={ id } class="alert alert-error mt-3 py-2 text-sm" role="alert" tabindex="-1" autofocus?={ focusSummary } data-form-error-focus?={ focusSummary }>
			<span>{ message }</span>
		</div>
	}
}

templ FormRequestError() {
	<p class="mt-3 text-sm text-error" role="alert" data-request-error hidden></p>
}
