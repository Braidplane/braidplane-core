package views

templ DataSourceIcon(dataSourceType string, size string) {
	<div
		class={ DataSourceIconClass(dataSourceType, size) }
		data-data-source-icon
		data-data-source-icon-type={ DataSourceIconType(dataSourceType) }
		aria-hidden="true"
	>
		if DataSourceIconAssetPath(dataSourceType) != "" {
			<span class="inline-flex items-start gap-0.5">
				<img
					class={ DataSourceIconImageClass(size), templ.KV("bg-white p-0.5", DataSourceIconType(dataSourceType) == "mongodb") }
					src={ versionedAssetPath(DataSourceIconAssetPath(dataSourceType)) }
					alt=""
					loading="lazy"
					decoding="async"
				/>
				if DataSourceIconType(dataSourceType) == "mongodb" {
					<sup class="text-[8px] leading-none">®</sup>
				} else if DataSourceIconType(dataSourceType) == "git" {
					<sup class="text-[8px] leading-none">™</sup>
				}
			</span>
		} else {
			<svg xmlns="http://www.w3.org/2000/svg" class={ DataSourceFallbackIconClass(size) } fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				if DataSourceIconType(dataSourceType) == "http" {
					<text x="12" y="14.5" text-anchor="middle" font-size="6" font-weight="800" fill="currentColor" stroke="none">HTTP</text>
				} else if DataSourceIconType(dataSourceType) == "ftp" {
					<text x="12" y="14.5" text-anchor="middle" font-size="7" font-weight="800" fill="currentColor" stroke="none">FTP</text>
				} else {
					<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3M16 7V3M7 11h10"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8v5a4 4 0 01-8 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 16v2.5a2.5 2.5 0 002.5 2.5H18"></path>
					<circle cx="20" cy="21" r="1.5"></circle>
				}
			</svg>
		}
	</div>
}

templ DataSourceIdentity(dataSourceType string, primaryLabel string, slug string, size string, variant string) {
	<div class={ DataSourceIdentityClass(variant) } data-data-source-identity>
		@DataSourceIcon(dataSourceType, size)
		<div class="min-w-0">
			<p class={ DataSourceIdentityPrimaryClass(variant) } title={ primaryLabel }>{ primaryLabel }</p>
			if slug != "" {
				<p class={ DataSourceIdentitySlugClass(variant) } title={ slug }>{ slug }</p>
			}
		</div>
	</div>
}
