package views

import (
	"fmt"
	"github.com/google/uuid"
)

// HTTPAuthFormData preserves only non-secret draft app settings after validation errors.
type HTTPAuthFormData struct {
	Mode                  string
	Issuer                string
	AuthorizationEndpoint string
	TokenEndpoint         string
	RevocationEndpoint    string
	ClientID              string
	Scopes                string
	Audience              string
}

func httpDraftFieldAttributes(prefix, field string) templ.Attributes {
	if prefix == "" {
		return templ.Attributes{}
	}
	return templ.Attributes{"id": prefix + "-" + field, "hx-preserve": true}
}

templ HTTPAuthenticationFields(f HTTPAuthFormData, draftIDPrefix string) {
	<div class="space-y-3" data-http-auth>
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">HTTP authentication</span></div>
			<select class="select select-bordered select-sm w-full" name="http_auth_type" data-http-auth-select>
				<option value="static" selected?={ f.Mode == "" || f.Mode == "static" }>Secret headers, bearer or basic</option>
				<option value="authorization_code" selected?={ f.Mode == "authorization_code" }>OAuth · Authorization code + PKCE</option>
				<option value="client_credentials" selected?={ f.Mode == "client_credentials" }>OAuth · Client credentials</option>
			</select>
		</label>
		<div class="grid gap-3 md:grid-cols-2" data-http-auth-fields="static">
			@httpSecretHeaderFields(draftIDPrefix)
			<label class="form-control w-full md:col-span-2">
				<div class="label py-1"><span class="label-text text-xs">Bearer token (optional)</span></div>
				<input class="input input-bordered input-sm w-full" type="password" name="bearer_token" { httpDraftFieldAttributes(draftIDPrefix, "bearer_token")... } autocomplete="off"/>
			</label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Basic username (optional)</span></div><input class="input input-bordered input-sm w-full" name="username" { httpDraftFieldAttributes(draftIDPrefix, "username")... } autocomplete="off"/></label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Basic password (optional)</span></div><input class="input input-bordered input-sm w-full" type="password" name="password" { httpDraftFieldAttributes(draftIDPrefix, "password")... } autocomplete="off"/></label>
		</div>
		<div class="space-y-3" data-http-auth-fields="authorization_code,client_credentials">
			<p class="text-xs text-base-content/70">Save the complete app settings, then connect from source settings. Stored settings and secrets are never prefilled. All OAuth endpoints and the API base URL must use HTTPS.</p>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Issuer URL</span></div><input class="input input-bordered input-sm w-full" type="url" name="http_oauth_issuer" value={ f.Issuer } data-http-required="authorization_code,client_credentials" placeholder="https://auth.example.com"/></label>
			<div class="space-y-3" data-http-auth-fields="authorization_code">
				<p class="text-xs text-base-content/70">Register the callback URL provided by your deployment administrator. The provider must return the issuer in its callback. PKCE S256 is required.</p>
				<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Authorization endpoint</span></div><input class="input input-bordered input-sm w-full" type="url" name="http_oauth_authorization_endpoint" value={ f.AuthorizationEndpoint } data-http-required="authorization_code" placeholder="https://auth.example.com/authorize"/></label>
			</div>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Token endpoint</span></div><input class="input input-bordered input-sm w-full" type="url" name="http_oauth_token_endpoint" value={ f.TokenEndpoint } data-http-required="authorization_code,client_credentials" placeholder="https://auth.example.com/token"/></label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Client ID</span></div><input class="input input-bordered input-sm w-full" name="http_oauth_client_id" value={ f.ClientID } data-http-required="authorization_code,client_credentials" autocomplete="off"/></label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Client secret (required for client credentials)</span></div><input class="input input-bordered input-sm w-full" type="password" name="http_oauth_client_secret" { httpDraftFieldAttributes(draftIDPrefix, "http_oauth_client_secret")... } data-http-required="client_credentials" autocomplete="off"/></label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Scopes (space separated, optional)</span></div><input class="input input-bordered input-sm w-full" name="http_oauth_scopes" value={ f.Scopes } placeholder="records.read offline_access"/></label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Audience (optional)</span></div><input class="input input-bordered input-sm w-full" name="http_oauth_audience" value={ f.Audience }/></label>
			<label class="form-control w-full"><div class="label py-1"><span class="label-text text-xs">Revocation endpoint (optional)</span></div><input class="input input-bordered input-sm w-full" type="url" name="http_oauth_revocation_endpoint" value={ f.RevocationEndpoint } placeholder="https://auth.example.com/revoke"/></label>
			<p class="text-xs text-base-content/70">Client-credentials apps can be tested before saving. Authorization-code apps must be saved and connected first. Without a revocation endpoint, revoking only disables the local grant.</p>
		</div>
	</div>
}

templ httpSecretHeaderFields(draftIDPrefix string) {
	{{ suggestionsID := "http-header-suggestions-" + uuid.NewString() }}
	if draftIDPrefix != "" {
		{{ suggestionsID = draftIDPrefix + "-header-suggestions" }}
	}
	<div class="md:col-span-2 space-y-2">
		<p class="text-sm font-medium">Secret headers (optional)</p>
		<p class="text-xs text-base-content/70">Choose a suggested name or enter a custom header. Use the full value, including Bearer or ApiKey for Authorization. Use headers, Bearer, or Basic as one method.</p>
		@httpHeaderNameSuggestions(suggestionsID, true)
		@httpSecretHeaderRow(0, suggestionsID, draftIDPrefix)
		<details>
			<summary class="cursor-pointer text-xs">More secret headers (up to 8)</summary>
			<div class="space-y-2 mt-2">
				for i := 1; i < 8; i++ {
					@httpSecretHeaderRow(i, suggestionsID, draftIDPrefix)
				}
			</div>
		</details>
		<p class="text-xs text-base-content/70">Values are encrypted and never prefilled. When replacing credentials, enter the complete set.</p>
	</div>
}

templ httpSecretHeaderRow(i int, suggestionsID, draftIDPrefix string) {
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
		<label class="form-control w-full">
			<span class="label-text text-xs">Header name</span>
			<input class="input input-bordered input-sm w-full" type="text" name={ fmt.Sprintf("secret_header_name_%d", i) } { httpDraftFieldAttributes(draftIDPrefix, fmt.Sprintf("secret_header_name_%d", i))... } aria-label={ fmt.Sprintf("Secret header %d name", i+1) } autocomplete="off" list={ suggestionsID } placeholder="X-Api-Key or custom name"/>
		</label>
		<label class="form-control w-full">
			<span class="label-text text-xs">Secret value</span>
			<input class="input input-bordered input-sm w-full" type="password" name={ fmt.Sprintf("secret_header_value_%d", i) } { httpDraftFieldAttributes(draftIDPrefix, fmt.Sprintf("secret_header_value_%d", i))... } aria-label={ fmt.Sprintf("Secret header %d value", i+1) } autocomplete="new-password" maxlength="4096"/>
		</label>
	</div>
}

// Standard request headers from https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers.
// Suggestions do not restrict custom names or override connector safety rules.
templ httpHeaderNameSuggestions(id string, secret bool) {
	<datalist id={ id }>
		<option value="Authorization"></option>
		<option value="X-Api-Key"></option>
		<option value="Api-Key"></option>
		<option value="X-Auth-Token"></option>
		<option value="X-Api-Token"></option>
		if !secret {
			for _, name := range []string{"Accept", "Accept-Charset", "Accept-Encoding", "Accept-Language", "Cache-Control", "Content-Disposition", "Content-Encoding", "Content-Language", "Content-Type", "Date", "Forwarded", "From", "If-Match", "If-Modified-Since", "If-None-Match", "If-Range", "If-Unmodified-Since", "Origin", "Prefer", "Range", "Referer", "User-Agent", "Via", "X-Forwarded-For", "X-Forwarded-Host", "X-Forwarded-Proto", "X-Requested-With"} {
				<option value={ name }></option>
			}
		}
	</datalist>
}
