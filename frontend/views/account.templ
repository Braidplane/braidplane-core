package views

templ AccountPage(shellData AuthenticatedShellData, state AccountPageState) {
	@AuthenticatedShell(shellData, AccountPageContent(shellData, state))
}

templ AccountPageContent(shellData AuthenticatedShellData, state AccountPageState) {
	<div class="space-y-6">
		if state.ProfileSuccess != "" {
			@SuccessPopup("account-profile-success", state.ProfileSuccess)
		}
		if state.SecuritySuccess != "" {
			@SuccessPopup("account-security-success", state.SecuritySuccess)
		}
		if state.InvitationsSuccess != "" {
			@SuccessPopup("account-invitations-success", state.InvitationsSuccess)
		}
		if state.ProfileError != "" {
			@ErrorPopup("account-profile-error", state.ProfileError, state.ProfileErrorDetails)
		}
		if state.SecurityError != "" {
			@ErrorPopup("account-security-error", state.SecurityError, state.SecurityDetails)
		}
		if state.InvitationsError != "" {
			@ErrorPopup("account-invitations-error", state.InvitationsError, state.InvitationsDetails)
		}
		@AccountPageTabs(state.ActiveTab)
		<div class={ AccountTabPanelClass(state.ActiveTab, AccountTabProfile) } id={ AccountTabPanelID(AccountTabProfile) } role="tabpanel" aria-labelledby={ AccountTabID(AccountTabProfile) }>
			<section class="rounded-xl border border-base-300 bg-base-100 p-4 lg:p-6">
				<div class="mb-5">
					<h2 class="text-xl font-semibold text-base-content">Profile</h2>
					<p class="mt-1 text-sm text-base-content/70">Personal contact details.</p>
				</div>
				<form class="grid gap-4" method="post" action="/account/profile" hx-post="/account/profile" hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML">
					<div class="grid gap-4 md:grid-cols-2">
						<label class="form-control">
							<span class="label-text">Full name</span>
							<input class="input input-bordered w-full" type="text" name="full_name" value={ state.ProfileForm.FullName } required/>
						</label>
						<label class="form-control">
							<span class="label-text">Locale</span>
							<input class="input input-bordered w-full" type="text" name="locale" value={ state.ProfileForm.Locale } placeholder="en"/>
						</label>
						<label class="form-control md:col-span-2">
							<span class="label-text">Profile picture URL</span>
							<input class="input input-bordered w-full" type="url" name="avatar_url" value={ state.ProfileForm.AvatarURL } placeholder="https://example.com/avatar.jpg"/>
						</label>
						<label class="form-control">
							<span class="label-text">Phone number</span>
							<input class="input input-bordered w-full" type="tel" name="phone_number" value={ state.ProfileForm.PhoneNumber } placeholder="+48123123123"/>
						</label>
						<label class="form-control">
							<span class="label-text">Job title</span>
							<input class="input input-bordered w-full" type="text" name="job_title" value={ state.ProfileForm.JobTitle } placeholder="Operations Manager"/>
						</label>
						<label class="form-control">
							<span class="label-text">Timezone</span>
							<input class="input input-bordered w-full" type="text" name="timezone" value={ state.ProfileForm.Timezone } placeholder="Europe/Warsaw"/>
						</label>
					</div>
					<div class="flex justify-end">
						<button class="btn btn-primary" type="submit">Save profile</button>
					</div>
				</form>
			</section>

			@AccountDeletionSection()
		</div>
		<div class={ AccountTabPanelClass(state.ActiveTab, AccountTabInvitations) } id={ AccountTabPanelID(AccountTabInvitations) } role="tabpanel" aria-labelledby={ AccountTabID(AccountTabInvitations) }>
			<section class="rounded-xl border border-base-300 bg-base-100 p-4 lg:p-6">
				<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
					<div>
						<h2 class="text-xl font-semibold text-base-content">Pending invitations</h2>
						<p class="mt-1 text-sm text-base-content/70">Organization invitations for your verified email address.</p>
					</div>
					<div class="badge badge-outline">{ MemberCountLabel(len(state.PendingInvitations)) }</div>
				</div>
				if len(state.PendingInvitations) == 0 {
					<div class="alert">
						<span>No pending invitations.</span>
					</div>
				} else {
					<div class="hidden grid-cols-[1.6fr_1fr_1fr_1fr_1fr_minmax(0,1.2fr)] gap-4 border-b border-base-300 px-2 pb-3 text-xs font-semibold uppercase tracking-wide text-base-content/60 md:grid">
						<div>Organization</div>
						<div>Role</div>
						<div>Status</div>
						<div>Sent</div>
						<div>Expires</div>
						<div class="text-right">Actions</div>
					</div>
					<div class="divide-y divide-base-300" id="account-member-invitations-list">
						for _, invitation := range state.PendingInvitations {
							<div class="grid gap-3 py-4 md:grid-cols-[1.6fr_1fr_1fr_1fr_1fr_minmax(0,1.2fr)] md:items-center">
								<div>
									<p class="font-medium text-base-content">{ string(invitation.OrganizationSlug) }</p>
									<p class="text-xs text-base-content/70">{ string(invitation.Email) }</p>
								</div>
								<div class="flex items-center gap-2">
									<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 md:hidden">Role</span>
									<div class="badge badge-outline">{ string(invitation.Role) }</div>
								</div>
								<div class="flex items-center gap-2">
									<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 md:hidden">Status</span>
									<div class={ MemberInvitationStatusBadgeClass(invitation.Status) }>{ string(invitation.Status) }</div>
								</div>
								<div class="text-sm text-base-content/80"><span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 md:hidden">Sent </span>{ invitation.LastSentAt.Format("2006-01-02") }</div>
								<div class="text-sm text-base-content/80"><span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 md:hidden">Expires </span>{ invitation.ExpiresAt.Format("2006-01-02") }</div>
								<div class="flex flex-col gap-2 sm:flex-row md:justify-end">
									if AccountActionsEnabled(ctx) {
										<form method="post" action={ templ.URL("/account/member-invitations/" + string(invitation.OrganizationSlug) + "/" + string(invitation.Slug) + "/accept") }>

											@AccountFields(ctx)
											<button class="btn btn-sm btn-primary w-full sm:w-auto" type="submit">Accept</button>
										</form>
									}
									<form method="post" action={ templ.URL("/account/member-invitations/" + string(invitation.OrganizationSlug) + "/" + string(invitation.Slug) + "/decline") } data-destructive-confirm={ DestructiveConfirmation("Decline", "member invitation", DestructiveResourceLabel(string(invitation.Email), string(invitation.OrganizationSlug)), "You will not join this organization.") }>
										<button class="btn btn-sm btn-outline w-full sm:w-auto" type="submit">Decline</button>
									</form>
								</div>
							</div>
						}
					</div>
				}
			</section>
		</div>
		<div class={ AccountTabPanelClass(state.ActiveTab, AccountTabSecurity) } id={ AccountTabPanelID(AccountTabSecurity) } role="tabpanel" aria-labelledby={ AccountTabID(AccountTabSecurity) }>
			<section class="rounded-xl border border-base-300 bg-base-100 p-4 lg:p-6">
				<h2 class="text-xl font-semibold text-base-content">Sign-in security</h2>
				<p class="mt-1 text-sm text-base-content/70">Require an email code after password sign-in.</p>
				<form class="mt-5 space-y-4" method="post" action="/account/security" hx-post="/account/security" hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML">
					<label class="flex cursor-pointer items-center justify-between gap-4 rounded-lg border border-base-300 p-4">
						<span>
							<span class="block text-sm font-semibold text-base-content">Email MFA</span>
							<span class="block text-xs text-base-content/70">Send a one-time code to your email during sign-in.</span>
						</span>
						<input class="toggle toggle-primary" type="checkbox" name="mfa_email_enabled" value="true" checked?={ state.ProfileForm.MFAEmailEnabled }/>
					</label>
					<button class="btn btn-primary w-full sm:w-auto" type="submit">Save security</button>
				</form>
			</section>
			@AccountPasswordManagementSection(state)
			@AccountPATManagementSection(state)
		</div>
	</div>
}

templ AccountPageTabs(activeTab AccountTab) {
	<div class="tabs tabs-border" role="tablist" aria-label="Account sections">
		<a class={ AccountTabClass(activeTab, AccountTabProfile) } id={ AccountTabID(AccountTabProfile) } role="tab" aria-selected={ AccountTabAriaSelected(activeTab, AccountTabProfile) } aria-controls={ AccountTabPanelID(AccountTabProfile) } href={ templ.URL(AccountTabHref(AccountTabProfile)) }>Profile</a>
		<a class={ AccountTabClass(activeTab, AccountTabInvitations) } id={ AccountTabID(AccountTabInvitations) } role="tab" aria-selected={ AccountTabAriaSelected(activeTab, AccountTabInvitations) } aria-controls={ AccountTabPanelID(AccountTabInvitations) } href={ templ.URL(AccountTabHref(AccountTabInvitations)) }>Invitations</a>
		<a class={ AccountTabClass(activeTab, AccountTabSecurity) } id={ AccountTabID(AccountTabSecurity) } role="tab" aria-selected={ AccountTabAriaSelected(activeTab, AccountTabSecurity) } aria-controls={ AccountTabPanelID(AccountTabSecurity) } href={ templ.URL(AccountTabHref(AccountTabSecurity)) }>Security</a>
	</div>
}

templ AccountPATPaginationInputs(state AccountPageState) {
	if state.PATsCursor != "" {
		<input type="hidden" name="pat_cursor" value={ state.PATsCursor }/>
	}
	if state.PATsDirection != "" {
		<input type="hidden" name="pat_direction" value={ state.PATsDirection }/>
	}
	if state.PATsPrevCursor != "" {
		<input type="hidden" name="pat_prev_cursor" value={ state.PATsPrevCursor }/>
	}
}

templ AccountPasswordManagementSection(state AccountPageState) {
	<section class="rounded-xl border border-base-300 bg-base-100 p-4 lg:p-6" id="account-password-security">
		<div>
			<h2 class="text-xl font-semibold text-base-content">Password</h2>
			<p class="mt-1 max-w-3xl text-sm text-base-content/70">Change the local password used for browser sign-in. Personal access tokens and organization API keys are managed separately.</p>
		</div>
		if AccountCanManagePassword(state.User) {
			<form class="mt-5 grid gap-4 md:grid-cols-3" method="post" action="/account/security/password" hx-post="/account/security/password" hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML">
				<label class="form-control">
					<span class="label-text">Current password</span>
					<input class="input input-bordered w-full" type="password" name="current_password" autocomplete="current-password" required/>
				</label>
				<label class="form-control">
					<span class="label-text">New password</span>
					<input class="input input-bordered w-full" type="password" name="new_password" autocomplete="new-password" minlength="8" required/>
				</label>
				<label class="form-control">
					<span class="label-text">Confirm new password</span>
					<input class="input input-bordered w-full" type="password" name="confirm_password" autocomplete="new-password" minlength="8" required/>
				</label>
				<div class="md:col-span-3">
					<button class="btn btn-primary w-full sm:w-auto" type="submit">Update password</button>
				</div>
			</form>
		} else {
			<div class="alert mt-5">
				<span>Password sign-in is not enabled for this account. Use your configured identity provider to manage sign-in credentials.</span>
			</div>
		}
	</section>
}

templ AccountPATManagementSection(state AccountPageState) {
	<section class="rounded-xl border border-base-300 bg-base-100 p-4 lg:p-6" id="account-pat-security">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-xl font-semibold text-base-content">Personal access tokens</h2>
				<p class="mt-1 max-w-3xl text-sm text-base-content/70">PATs authenticate as you for CLI and member-owned workflows. Use organization API keys for organization-scoped automation.</p>
			</div>
			<div class="badge badge-outline">{ MemberCountLabel(len(state.PersonalAccessTokens)) }</div>
		</div>
		if state.PATTokenNotice != nil {
			<div class="alert alert-warning mt-5 items-start">
				<div class="min-w-0">
					<p class="font-semibold">{ state.PATTokenNotice.Action } token for { state.PATTokenNotice.Name }</p>
					<p class="mt-1 text-sm">Copy this token now. It will not be shown again after this page changes.</p>
					<code class="mt-3 block break-all rounded-md bg-base-100 p-3 font-mono text-sm text-base-content">{ state.PATTokenNotice.Token }</code>
				</div>
			</div>
		}
		<div class="mt-5 rounded-lg border border-base-300 bg-base-200/40 p-4">
			<h3 class="text-base font-semibold text-base-content">Create token</h3>
			<p class="mt-1 text-xs text-base-content/70">Give the token a clear name and optional expiration. The raw token is shown once.</p>
			<form class="mt-4 grid gap-3" method="post" action="/account/security/personal-access-tokens" hx-post="/account/security/personal-access-tokens" hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML" hx-indicator="#account-pat-list-loading">
				<div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)_220px]">
					<input class="input input-bordered w-full" type="text" name="name" placeholder="Developer CLI" value={ state.PATCreateForm.Name } required/>
					<input class="input input-bordered w-full" type="text" name="description" placeholder="Optional description" value={ state.PATCreateForm.Description }/>
					<input class="input input-bordered w-full" type="datetime-local" name="expires_at" value={ state.PATCreateForm.ExpiresAt } aria-label="Expiration"/>
				</div>
				@CustomizeIdentifier(state.PATCreateForm.Slug)
				<label class="flex cursor-pointer items-start gap-3 rounded-lg border border-warning/30 bg-warning/5 p-3">
					<input class="checkbox checkbox-warning checkbox-sm mt-0.5" type="checkbox" name="can_manage_personal_access_tokens" checked?={ state.PATCreateForm.CanManagePersonalAccessTokens }/>
					<span>
						<span class="block text-sm font-medium text-base-content">Allow this token to manage personal access tokens</span>
						<span class="mt-0.5 block text-xs text-base-content/70">It may create, edit, rotate, and revoke tokens you own. Tokens it creates cannot inherit this permission.</span>
					</span>
				</label>
				<div class="flex justify-end">
					<button class="btn btn-primary w-full sm:w-auto" type="submit">Create token</button>
				</div>
			</form>
		</div>
		<div id="account-pat-list-loading" class="htmx-indicator mt-3 rounded-lg border border-base-300 bg-base-200 px-3 py-2 text-xs text-base-content/70">
			<span class="loading loading-spinner loading-xs align-middle"></span>
			<span class="ml-2 align-middle">Loading personal access tokens</span>
		</div>
		<div class="mt-5 rounded-lg border border-base-300 bg-base-200/40 p-4">
			if len(state.PersonalAccessTokens) == 0 {
				<div class="alert">
					<span>{ AccountPATEmptyMessage(state) }</span>
				</div>
			} else {
				<div class="hidden grid-cols-[1.25fr_.7fr_.9fr_.9fr_.9fr_minmax(12rem,1.2fr)] gap-4 border-b border-base-300 px-2 pb-3 text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:grid">
					<div>Token</div>
					<div>Status</div>
					<div>Expires</div>
					<div>Last used</div>
					<div>Created</div>
					<div class="text-right">Actions</div>
				</div>
				<div class="divide-y divide-base-300">
					for _, token := range state.PersonalAccessTokens {
						<div class="grid gap-3 py-4 lg:grid-cols-[1.25fr_.7fr_.9fr_.9fr_.9fr_minmax(12rem,1.2fr)] lg:items-center">
							<div class="min-w-0">
								<p class="font-medium text-base-content">{ string(token.Name) }</p>
								<p class="break-all text-xs text-base-content/70">{ string(token.Slug) } · { token.TokenPrefix }</p>
								if token.Description != nil && *token.Description != "" {
									<p class="mt-1 text-xs text-base-content/70">{ *token.Description }</p>
								}
								if token.CanManagePersonalAccessTokens {
									<span class="badge badge-warning badge-sm mt-2">Can manage PATs</span>
								}
							</div>
							<div><span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Status </span><span class={ AccountPATStatusBadgeClass(token) }>{ AccountPATStatusLabel(token) }</span></div>
							<div class="text-sm text-base-content/80"><span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Expires </span>{ FormatOptionalAccountPATTime(token.ExpiresAt) }</div>
							<div class="text-sm text-base-content/80"><span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Last used </span>{ FormatOptionalAccountPATTime(token.LastUsedAt) }</div>
							<div class="text-sm text-base-content/80"><span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Created </span>{ token.CreatedAt.Format("2006-01-02 15:04 MST") }</div>
							<div class="flex flex-wrap gap-2 lg:justify-end">
								if AccountPATCanEdit(token) {
									<button class="btn btn-ghost btn-xs" type="button" aria-controls={ AccountPATEditPanelID(token) } aria-expanded="false" data-toggle-target={ AccountPATEditPanelID(token) }>Edit</button>
								}
								if AccountPATCanRotate(token) {
									<form method="post" action={ templ.URL("/account/security/personal-access-tokens/" + string(token.Slug) + "/rotate") } hx-post={ "/account/security/personal-access-tokens/" + string(token.Slug) + "/rotate" } hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML show:none focus-scroll:false" hx-indicator="#account-pat-list-loading" data-preserve-scroll hx-confirm={ DestructiveConfirmation("Rotate", "personal access token", DestructiveResourceLabel(string(token.Name), string(token.Slug)), "The current token will stop working immediately.") } data-destructive-confirm={ DestructiveConfirmation("Rotate", "personal access token", DestructiveResourceLabel(string(token.Name), string(token.Slug)), "The current token will stop working immediately.") }>
										@AccountPATPaginationInputs(state)
										<button class="btn btn-outline btn-xs" type="submit">Rotate</button>
									</form>
								}
								if AccountPATCanRevoke(token) {
									<form method="post" action={ templ.URL("/account/security/personal-access-tokens/" + string(token.Slug) + "/revoke") } hx-post={ "/account/security/personal-access-tokens/" + string(token.Slug) + "/revoke" } hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML show:none focus-scroll:false" hx-indicator="#account-pat-list-loading" data-preserve-scroll hx-confirm={ DestructiveConfirmation("Revoke", "personal access token", DestructiveResourceLabel(string(token.Name), string(token.Slug)), "Requests using it will be rejected immediately.") } data-destructive-confirm={ DestructiveConfirmation("Revoke", "personal access token", DestructiveResourceLabel(string(token.Name), string(token.Slug)), "Requests using it will be rejected immediately.") }>
										@AccountPATPaginationInputs(state)
										<button class="btn btn-error btn-outline btn-xs" type="submit">Revoke</button>
									</form>
								}
								if AccountPATCanDelete(token) {
									<form method="post" action={ templ.URL("/account/security/personal-access-tokens/" + string(token.Slug) + "/delete") } hx-post={ "/account/security/personal-access-tokens/" + string(token.Slug) + "/delete" } hx-target="#shell-layout" hx-select="#shell-layout" hx-swap="outerHTML show:none focus-scroll:false" hx-indicator="#account-pat-list-loading" data-preserve-scroll hx-confirm={ DestructiveConfirmation("Remove", "revoked personal access token metadata", DestructiveResourceLabel(string(token.Name), string(token.Slug)), "This cannot be undone.") } data-destructive-confirm={ DestructiveConfirmation("Remove", "revoked personal access token metadata", DestructiveResourceLabel(string(token.Name), string(token.Slug)), "This cannot be undone.") }>
										@AccountPATPaginationInputs(state)
										<button class="btn btn-error btn-outline btn-xs" type="submit">Remove</button>
									</form>
								}
							</div>
							if AccountPATCanEdit(token) {
								<form
									id={ AccountPATEditPanelID(token) }
									class="hidden rounded-lg border border-base-300 bg-base-200/35 p-3 lg:col-span-6"
									method="post"
									action={ templ.URL("/account/security/personal-access-tokens/" + string(token.Slug) + "/update") }
									hx-post={ "/account/security/personal-access-tokens/" + string(token.Slug) + "/update" }
									hx-target="#shell-layout"
									hx-select="#shell-layout"
									hx-swap="outerHTML show:none focus-scroll:false"
									hx-indicator="#account-pat-list-loading"
									data-preserve-scroll
									data-dirty-form={ "account-pat-" + string(token.Slug) + "-update" }
								>
									@AccountPATPaginationInputs(state)
									<div class="grid gap-3 xl:grid-cols-[minmax(0,1.1fr)_13rem_minmax(0,1fr)] xl:items-end">
										<label class="form-control w-full">
											<div class="label py-1"><span class="label-text text-xs">Name</span></div>
											<input class="input input-bordered input-sm w-full" type="text" name="name" value={ string(token.Name) } required/>
										</label>
										<label class="form-control w-full">
											<div class="label py-1"><span class="label-text text-xs">Expires</span></div>
											<input class="input input-bordered input-sm w-full" type="datetime-local" name="expires_at" value={ FormatAccountPATDateTimeLocal(token.ExpiresAt) }/>
										</label>
										<label class="form-control w-full">
											<div class="label py-1"><span class="label-text text-xs">Description</span></div>
											<input class="input input-bordered input-sm w-full" type="text" name="description" value={ AccountPATDescriptionValue(token.Description) }/>
										</label>
									</div>
									<label class="mt-3 flex cursor-pointer items-start gap-3 rounded-lg border border-warning/30 bg-warning/5 p-3">
										<input class="checkbox checkbox-warning checkbox-sm mt-0.5" type="checkbox" name="can_manage_personal_access_tokens" checked?={ token.CanManagePersonalAccessTokens }/>
										<span>
											<span class="block text-sm font-medium text-base-content">Allow this token to manage personal access tokens</span>
											<span class="mt-0.5 block text-xs text-base-content/70">It may create, edit, rotate, and revoke tokens you own. Tokens it creates cannot inherit this permission.</span>
										</span>
									</label>
									<div class="mt-3 flex justify-end">
										<button class="btn btn-primary btn-sm" type="submit" data-dirty-submit disabled>Save</button>
									</div>
								</form>
							}
						</div>
					}
				</div>
			}
		</div>
		if state.PATsPrevCursor != "" || state.PATsHasMore {
			<div class="mt-5 flex items-center justify-end gap-2">
				if state.PATsPrevCursor != "" {
					<a class="btn btn-sm btn-outline" href={ templ.URL("/account?tab=security&pat_cursor=" + state.PATsPrevCursor + "&pat_direction=prev") }>Previous</a>
				} else {
					<button class="btn btn-sm btn-outline" type="button" disabled>Previous</button>
				}
				if state.PATsHasMore && state.PATsNextCursor != "" {
					<a class="btn btn-sm btn-outline" href={ templ.URL("/account?tab=security&pat_cursor=" + state.PATsNextCursor + "&pat_direction=next") }>Next</a>
				} else {
					<button class="btn btn-sm btn-outline" type="button" disabled>Next</button>
				}
			</div>
		}
	</section>
}
