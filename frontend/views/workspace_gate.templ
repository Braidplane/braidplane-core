package views

templ WorkspaceGatePage(title string, usageType string, organizationWorkspaceName string, personalWorkspaceName string, returnTo string, pageError string, pageErrorDetails string, customSlug string) {
	@AuthPage(title, true, WorkspaceGatePageContent(usageType, organizationWorkspaceName, personalWorkspaceName, returnTo, pageError, pageErrorDetails, customSlug))
}

templ WorkspaceGatePageContent(usageType string, organizationWorkspaceName string, personalWorkspaceName string, returnTo string, pageError string, pageErrorDetails string, customSlug string) {
	<div class="space-y-5">
		if pageError != "" {
			@ErrorPopup("workspace-gate-error-popup", pageError, pageErrorDetails)
		}
		<div>
			<p class="text-xs font-semibold uppercase tracking-wide text-primary">Workspace setup</p>
			<h1 class="mt-2 text-2xl font-semibold text-base-content">Set up your workspace</h1>
			<p class="mt-2 text-sm text-base-content/70">Choose who will use this workspace. Both options have the same product features.</p>
		</div>
        if HasAccountNotice(ctx) {
            <div class="rounded-lg border border-base-300 bg-base-200/40 p-4 text-sm text-base-content/75">
                @AccountNotice(ctx)
            </div>
        }
		<form class="space-y-4" method="post" action="/workspace" hx-post="/workspace" hx-target="body" hx-select="body" hx-swap="outerHTML">
			<input type="hidden" name="usage_type" value={ usageType }/>
			if returnTo != "" {
				<input type="hidden" name="return_to" value={ returnTo }/>
			}
			<fieldset>
				<legend class="label-text mb-2">Who is this workspace for?</legend>
				<div class="grid gap-2 sm:grid-cols-2">
					<a class={ signupUsageClass(usageType, "personal") } href={ templ.URL(WorkspaceGateUsageURL("personal", returnTo)) }><strong class="block text-sm font-semibold text-base-content">Personal</strong><span class="mt-1 block text-xs leading-5 text-base-content/65">For your own projects; invite others later.</span></a>
					<a class={ signupUsageClass(usageType, "organization") } href={ templ.URL(WorkspaceGateUsageURL("organization", returnTo)) }><strong class="block text-sm font-semibold text-base-content">Organization</strong><span class="mt-1 block text-xs leading-5 text-base-content/65">For a team or company; no business details needed.</span></a>
				</div>
			</fieldset>
			if usageType == "organization" {
				<label class="form-control w-full">
					<div class="label">
						<span class="label-text">Organization workspace name</span>
					</div>
					<input class="input input-bordered w-full" type="text" name="organization_workspace_name" placeholder="Acme Operations" value={ organizationWorkspaceName } autocomplete="organization" maxlength="255" required/>
				</label>
			} else {
				<div class="rounded-lg border border-base-300 bg-base-200/40 p-4">
					<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Workspace name</p>
					<p class="mt-1 text-base font-medium text-base-content">{ personalWorkspaceName }</p>
				</div>
			}
			@CustomizeIdentifier(customSlug)
			<button class="btn btn-primary w-full" type="submit">Create workspace</button>
		</form>
		<a class="btn btn-outline btn-sm w-full" href="/account">Account settings</a>
		<form method="post" action="/auth/logout" hx-post="/auth/logout" hx-target="body" hx-select="body" hx-swap="outerHTML">
			<button class="btn btn-ghost btn-sm w-full" type="submit">Sign out</button>
		</form>
	</div>
}
