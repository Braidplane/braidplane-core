package views

import api "github.com/Braidplane/braidplane-core/api-schema/gen/client"

// DataSourceFormFields holds the current field values for the datasource creation form.
type DataSourceFormFields struct {
	HTTPAuth HTTPAuthFormData
	OrgSlug  string
	Name     string
	Slug     string
	// Common
	DSType                    api.DataSourceType
	Host                      string
	Port                      string
	Database                  string
	Username                  string
	Password                  string
	DatabaseAllowPrivateHosts bool

	// PostgreSQL
	SSLMode string

	// MongoDB
	AuthDatabase string

	// BigQuery
	ProjectID          string
	Location           string
	DefaultDataset     string
	MaximumBytesBilled string
	ServiceAccountJSON string

	// Snowflake
	Account               string
	Warehouse             string
	Schema                string
	Role                  string
	SnowflakeAuthType     string
	SnowflakeSelectTables string
	SnowflakeInsertTables string

	// HTTP
	BaseURL               string
	HealthPath            string
	OpenAPIURL            string
	OpenAPIFetchTimeout   string
	BearerToken           string
	TimeoutSeconds        string
	PrivateAppToken       string
	HubSpotReadOnly       bool
	HTTPAllowPrivateHosts bool

	// Git-like
	GitRepoURL                  string
	GitDefaultBranch            string
	GitBasePath                 string
	GitAuthType                 string
	GitUsername                 string
	GitToken                    string
	GitSSHPrivateKey            string
	GitSSHKnownHosts            string
	GitSSHPassphrase            string
	GitAllowPrivateHosts        bool
	AllowPrivateDataSourceHosts bool
}

templ DataSourceNewPage(title string, orgSlug string, fields DataSourceFormFields, parseError string, parseSuccess string, pageError string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="control-room">
		@AppHead(title, true)
		<body class="min-h-screen bg-base-200">
			<main class="mx-auto min-h-screen w-full max-w-xl px-4 py-8">
				<div class="card w-full bg-base-100 shadow-md">
					<div class="card-body gap-4">
						<h1 class="text-2xl font-semibold">Add data source</h1>
						<p class="text-sm text-base-content/70">Connect a system, then save and run your first read.</p>
						if pageError != "" {
							<div class="alert alert-error">
								<span>{ pageError }</span>
							</div>
						}
						<form class="space-y-4" method="post" action={ templ.URL("/organizations/" + orgSlug + "/datasources") } hx-post={ "/organizations/" + orgSlug + "/datasources" } hx-target="body" hx-select="body" hx-swap="outerHTML" data-snowflake-auth-form>
							<label class="form-control w-full">
								<div class="label">
									<span class="label-text font-medium">Name</span>
								</div>
								<input
									class="input input-bordered w-full"
									type="text"
									name="name"
									placeholder="e.g. Test warehouse"
									value={ fields.Name }
									required
								/>
							</label>
							@CustomizeIdentifier(fields.Slug)
							<label class="form-control w-full">
								<div class="label">
									<span class="label-text font-medium">Type</span>
								</div>
								<select
									class="select select-bordered w-full"
									name="type"
									id="ds-type-select"
									hx-get={ "/organizations/" + orgSlug + "/datasources/new/fields" }
									hx-target="#ds-fields"
									hx-select="#ds-fields"
									hx-swap="outerHTML"
									hx-trigger="change"
									hx-include="[name='uri'],[name='type'],[name='database_allow_private_hosts'],[name='http_allow_private_hosts'],[name='git_allow_private_hosts']"
								>
									<option value="">Select type…</option>
									<option value="s3" selected?={ fields.DSType == api.DataSourceTypeS3 }>S3-compatible storage</option>
									<option value="postgres" selected?={ fields.DSType == api.DataSourceTypePostgres }>PostgreSQL</option>
									<option value="mysql" selected?={ fields.DSType == api.DataSourceTypeMysql }>MySQL</option>
									<option value="bigquery" selected?={ fields.DSType == api.DataSourceTypeBigquery }>BigQuery</option>
									<option value="snowflake" selected?={ fields.DSType == api.DataSourceTypeSnowflake }>Snowflake</option>
									<option value="mongodb" selected?={ fields.DSType == api.DataSourceTypeMongodb }>MongoDB</option>
									<option value="http" selected?={ fields.DSType == api.DataSourceTypeHttp }>HTTP</option>
									<option value="hubspot" selected?={ fields.DSType == api.DataSourceTypeHubspot }>HubSpot</option>
									<option value="git" selected?={ fields.DSType == api.DataSourceTypeGit }>Git</option>
								</select>
							</label>
							<details class="space-y-3" open?={ parseError != "" || parseSuccess != "" }>
								<summary class="cursor-pointer text-sm font-medium focus-visible:outline-primary">Import a connection URI</summary>
								<p class="text-sm text-base-content/70">Optionally paste a connection string to fill the fields below.</p>
								<label class="form-control w-full">
									<input
										class="input input-bordered w-full font-mono text-sm"
										type="text"
										name="uri"
										id="uri-input"
										placeholder="postgres://user:pass@host:5432/db"
										autocomplete="off"
									/>
								</label>
								if parseError != "" {
									<div class="alert alert-error alert-sm py-2 text-sm">
										<span>{ parseError }</span>
									</div>
								}
								if parseSuccess != "" {
									<div class="alert alert-success alert-sm py-2 text-sm">
										<span>{ parseSuccess }</span>
									</div>
								}
								<button
									class="btn btn-sm btn-outline"
									type="button"
									hx-post={ "/organizations/" + orgSlug + "/datasources/new/parse-uri" }
									hx-target="#ds-fields"
									hx-select="#ds-fields"
									hx-swap="outerHTML"
									hx-include="[name='type'],[name='uri'],[name='database_allow_private_hosts'],[name='http_allow_private_hosts'],[name='git_allow_private_hosts']"
								>
									Parse URI
								</button>
							</details>
							@DataSourceFields(fields, "")
							<div class="flex flex-wrap gap-3 pt-2">
								if fields.DSType == api.DataSourceTypeBigquery {
									<button class="btn btn-primary flex-1" type="submit" name="type" value="bigquery">Continue with Google</button>
								} else {
									<button class="btn btn-primary flex-1" type="submit">Add data source</button>
								}
								<a class="btn btn-outline" href={ templ.URL("/orgs/" + orgSlug + "/data-sources") }>Cancel</a>
							</div>
						</form>
					</div>
				</div>
			</main>
		</body>
	</html>
}

// DataSourceFields renders the type-specific connection fields.
// It is also used as an HTMX partial for both URI parse responses and type-selector changes.
templ DataSourceFields(fields DataSourceFormFields, parseMessage string) {
	<div id="ds-fields" class="space-y-3">
		if parseMessage != "" {
			<div class={ "alert alert-sm py-2 text-sm " + parseMessageClass(parseMessage) }>
				<span>{ parseMessage }</span>
			</div>
		}
		switch fields.DSType {
			case api.DataSourceTypeS3:
				<p class="text-sm text-base-content/70">Continue to configure and test S3 on the data sources page.</p>
			case api.DataSourceTypePostgres:
				@postgresFields(fields)
			case api.DataSourceTypeMysql:
				@mysqlFields(fields)
			case api.DataSourceTypeMongodb:
				@mongodbFields(fields)
			case api.DataSourceTypeBigquery:
				@bigQueryFields(fields)
			case api.DataSourceTypeSnowflake:
				@snowflakeFields(fields)
			case api.DataSourceTypeHttp:
				@httpFields(fields)
			case api.DataSourceTypeHubspot:
				@hubspotFields(fields)
			case api.DataSourceTypeGit:
				@gitFields(fields)
			case api.DataSourceTypeGithub, api.DataSourceTypeGitlab:
				<p class="text-sm text-base-content/70">Use the managed provider flow on the data sources page.</p>
			default:
				<p class="text-sm text-base-content/50 italic">Select a datasource type to see connection fields.</p>
		}
	</div>
}

templ snowflakeFields(f DataSourceFormFields) {
	<div class="grid gap-3 sm:grid-cols-2">
		<label class="form-control w-full sm:col-span-2">
			<div class="label"><span class="label-text font-medium">Account</span></div>
			<input class="input input-bordered w-full font-mono text-sm" type="text" name="account" value={ f.Account } required/>
		</label>
		<label class="form-control w-full">
			<div class="label"><span class="label-text font-medium">Warehouse</span></div>
			<input class="input input-bordered w-full font-mono text-sm" type="text" name="warehouse" value={ f.Warehouse } required/>
		</label>
		<label class="form-control w-full">
			<div class="label"><span class="label-text font-medium">Database</span></div>
			<input class="input input-bordered w-full font-mono text-sm" type="text" name="database" value={ f.Database } required/>
		</label>
		<label class="form-control w-full">
			<div class="label"><span class="label-text font-medium">Schema</span></div>
			<input class="input input-bordered w-full font-mono text-sm" type="text" name="schema" value={ f.Schema } required/>
		</label>
		<label class="form-control w-full">
			<div class="label"><span class="label-text font-medium">Dedicated role (required for WIF)</span></div>
			<input class="input input-bordered w-full font-mono text-sm" type="text" name="role" value={ f.Role }/>
		</label>
		<label class="form-control w-full sm:col-span-2">
			<div class="label"><span class="label-text font-medium">Authentication</span></div>
			<select class="select select-bordered w-full" name="snowflake_auth_type" data-snowflake-auth-select>
				<option value="workload_identity" selected?={ f.SnowflakeAuthType == "" || f.SnowflakeAuthType == "workload_identity" }>Workload identity (requires onboarding)</option>
				<option value="password" selected?={ f.SnowflakeAuthType == "password" }>Username and password</option>
			</select>
		</label>
		@SnowflakeObjectFields(f.SnowflakeSelectTables, f.SnowflakeInsertTables)
		<div class="rounded-lg border border-primary/30 bg-primary/5 p-3 sm:col-span-2" data-snowflake-auth-fields="workload_identity">
			<p class="text-xs text-base-content/70">Save the connection, run the generated SQL script in Snowflake, then select Verify. Braidplane provisions the identity automatically. No administrator password or token is requested.</p>
		</div>
		<label class="form-control w-full" data-snowflake-auth-fields="password">
			<div class="label"><span class="label-text font-medium">Username</span></div>
			<input class="input input-bordered w-full" type="text" name="username" value={ f.Username } data-required-for="snowflake"/>
		</label>
		<label class="form-control w-full" data-snowflake-auth-fields="password">
			<div class="label"><span class="label-text font-medium">Password</span></div>
			<input class="input input-bordered w-full" type="password" name="password" data-required-for="snowflake"/>
		</label>
	</div>
}

func parseMessageClass(msg string) string {
	if msg == "" {
		return ""
	}
	// Success messages start with "URI parsed" prefix set by the handler.
	if len(msg) >= 10 && msg[:10] == "URI parsed" {
		return "alert-success"
	}
	return "alert-error"
}

templ postgresFields(f DataSourceFormFields) {
	@postgresSSLModeField(f.SSLMode)
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Host</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="host" placeholder="db.example.com" value={ f.Host } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Port</span>
		</div>
		<input class="input input-bordered w-full" type="number" name="port" placeholder="5432" value={ portOrDefault(f.Port, "5432") } min="1" max="65535" required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Database</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="database" placeholder="mydb" value={ f.Database } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Username</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="username" placeholder="app_user" value={ f.Username } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Password</span>
		</div>
		<input class="input input-bordered w-full" type="password" name="password" placeholder="••••••••" required/>
	</label>
	if f.AllowPrivateDataSourceHosts {
		<label class="label cursor-pointer justify-start gap-2">
			<input class="checkbox checkbox-sm" type="checkbox" name="database_allow_private_hosts" checked?={ f.DatabaseAllowPrivateHosts }/>
			<span class="label-text">Allow private hosts</span>
		</label>
	}
}

templ postgresSSLModeField(mode string) {
	<label class="form-control w-full">
		<div class="label py-1"><span class="label-text text-xs">SSL mode</span></div>
		<select class="select select-bordered select-sm w-full" name="sslmode">
			<option value="" selected?={ mode == "" }>Default (verify-full)</option>
			<option value="verify-full" selected?={ mode == "verify-full" }>verify-full</option>
			<option value="verify-ca" selected?={ mode == "verify-ca" }>verify-ca</option>
			<option value="require" selected?={ mode == "require" }>require</option>
			<option value="prefer" selected?={ mode == "prefer" }>prefer</option>
			<option value="allow" selected?={ mode == "allow" }>allow</option>
			<option value="disable" selected?={ mode == "disable" }>disable</option>
		</select>
		<span class="label-text-alt mt-1">Modes other than verify-full require the local development transport exception.</span>
	</label>
}

templ mysqlFields(f DataSourceFormFields) {
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Host</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="host" placeholder="mysql.example.com" value={ f.Host } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Port</span>
		</div>
		<input class="input input-bordered w-full" type="number" name="port" placeholder="3306" value={ portOrDefault(f.Port, "3306") } min="1" max="65535" required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Database</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="database" placeholder="analytics" value={ f.Database } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Username</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="username" placeholder="app_user" value={ f.Username } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Password</span>
		</div>
		<input class="input input-bordered w-full" type="password" name="password" placeholder="••••••••"/>
		<span class="label-text-alt mt-1">Leave blank only for an account configured without a password.</span>
	</label>
	if f.AllowPrivateDataSourceHosts {
		<label class="label cursor-pointer justify-start gap-2">
			<input class="checkbox checkbox-sm" type="checkbox" name="database_allow_private_hosts" checked?={ f.DatabaseAllowPrivateHosts }/>
			<span class="label-text">Allow private hosts</span>
		</label>
	}
}

templ mongodbFields(f DataSourceFormFields) {
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Host</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="host" placeholder="mongodb.example.com" value={ f.Host } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Port</span>
		</div>
		<input class="input input-bordered w-full" type="number" name="port" placeholder="27017" value={ portOrDefault(f.Port, "27017") } min="1" max="65535" required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Database</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="database" placeholder="app_data" value={ f.Database } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Auth database <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="text" name="auth_database" placeholder="admin" value={ f.AuthDatabase }/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Username</span>
		</div>
		<input class="input input-bordered w-full" type="text" name="username" placeholder="app_user" value={ f.Username } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Password</span>
		</div>
		<input class="input input-bordered w-full" type="password" name="password" placeholder="••••••••" required/>
	</label>
	if f.AllowPrivateDataSourceHosts {
		<label class="label cursor-pointer justify-start gap-2">
			<input class="checkbox checkbox-sm" type="checkbox" name="database_allow_private_hosts" checked?={ f.DatabaseAllowPrivateHosts }/>
			<span class="label-text">Allow private hosts</span>
		</label>
	}
}

templ bigQueryFields(f DataSourceFormFields) {
	<div class="rounded-lg border border-primary/30 bg-primary/5 p-3 sm:col-span-2">
		<p class="text-sm font-medium text-primary">Connect with Google</p>
		<p class="mt-1 text-xs text-base-content/70">BigQuery uses Google OAuth. Continue on the data sources page to choose the project and dataset.</p>
		<button class="btn btn-primary btn-sm mt-3" type="submit" name="type" value="bigquery">Continue to Google connection</button>
	</div>
}

templ httpFields(f DataSourceFormFields) {
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Base URL</span>
		</div>
		<input class="input input-bordered w-full font-mono text-sm" type="url" name="base_url" placeholder="https://api.example.com" value={ f.BaseURL } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Health path <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full font-mono text-sm" type="text" name="health_path" placeholder="/health" value={ f.HealthPath }/>
	</label>
	<div class="rounded-xl border border-base-300 bg-base-200/40 p-4 space-y-2">
		<p class="text-sm font-medium text-base-content">OpenAPI import</p>
		<p class="text-xs text-base-content/60">Import operations from an OpenAPI document for schema browsing and query authoring.</p>
	</div>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">OpenAPI spec URL <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full font-mono text-sm" type="url" name="openapi_url" placeholder="https://api.example.com/openapi.json" value={ f.OpenAPIURL }/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">OpenAPI fetch timeout <span class="text-base-content/50">(seconds, optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="number" name="openapi_fetch_timeout_seconds" placeholder="10" value={ f.OpenAPIFetchTimeout } min="1" max="60"/>
	</label>
	@HTTPAuthenticationFields(f.HTTPAuth, "data-source-new-http")
	if f.AllowPrivateDataSourceHosts {
		<label class="label cursor-pointer justify-start gap-2">
			<input class="checkbox checkbox-sm" type="checkbox" name="http_allow_private_hosts" checked?={ f.HTTPAllowPrivateHosts }/>
			<span class="label-text">Allow private hosts</span>
		</label>
	}
}

templ hubspotFields(f DataSourceFormFields) {
	<div class="rounded-xl border border-base-300 bg-base-200/40 p-4 space-y-2">
		<p class="text-sm font-medium text-base-content">HubSpot CRM</p>
		<p class="text-xs text-base-content/60">This manual credential form uses a private app token. Supported CRM objects are contacts, companies, deals, and permitted custom objects; writable sources support schema-validated upserts.</p>
	</div>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Access mode</span>
		</div>
		<select class="select select-bordered w-full" name="hubspot_access_mode">
			<option value="read" selected?={ f.HubSpotReadOnly }>Read-only source</option>
			<option value="write" selected?={ !f.HubSpotReadOnly }>Write-enabled upsert destination</option>
		</select>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Timeout seconds <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="number" name="timeout_seconds" placeholder="5" value={ f.TimeoutSeconds } min="1" max="300"/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Private app token</span>
		</div>
		<input class="input input-bordered w-full" type="password" name="private_app_token" placeholder="pat-..." required/>
	</label>
}

templ gitFields(f DataSourceFormFields) {
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Repository URL</span>
		</div>
		<input class="input input-bordered w-full font-mono text-sm" type="text" name="git_repo_url" placeholder="https://github.com/org/repo.git" value={ f.GitRepoURL } required/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Default branch <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="text" name="git_default_branch" placeholder="main" value={ f.GitDefaultBranch }/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Base path <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="text" name="git_base_path" placeholder="pipelines" value={ f.GitBasePath }/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">Auth type</span>
		</div>
		<select class="select select-bordered w-full" name="git_auth_type">
			<option value="https" selected?={ f.GitAuthType == "" || f.GitAuthType == "https" }>HTTPS</option>
			<option value="ssh" selected?={ f.GitAuthType == "ssh" }>SSH</option>
		</select>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">HTTPS username <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="text" name="git_username" placeholder="x-access-token or git" value={ f.GitUsername }/>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">HTTPS token or PAT <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="password" name="git_token" placeholder="••••••••"/>
	</label>
	<label class="form-control w-full md:col-span-2">
		<div class="label">
			<span class="label-text">SSH private key <span class="text-base-content/50">(required for SSH)</span></span>
		</div>
		<textarea class="textarea textarea-bordered w-full min-h-32 font-mono text-sm" name="git_ssh_private_key" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
	</label>
	<label class="form-control w-full md:col-span-2">
		<div class="label">
			<span class="label-text">SSH known_hosts <span class="text-base-content/50">(required for SSH)</span></span>
		</div>
		<textarea class="textarea textarea-bordered w-full min-h-24 font-mono text-sm" name="git_ssh_known_hosts" placeholder="github.com ssh-ed25519 AAAAC3...">{ f.GitSSHKnownHosts }</textarea>
	</label>
	<label class="form-control w-full">
		<div class="label">
			<span class="label-text">SSH passphrase <span class="text-base-content/50">(optional)</span></span>
		</div>
		<input class="input input-bordered w-full" type="password" name="git_ssh_passphrase" placeholder="••••••••"/>
	</label>
	if f.AllowPrivateDataSourceHosts {
		<label class="label cursor-pointer justify-start gap-2">
			<input class="checkbox checkbox-sm" type="checkbox" name="git_allow_private_hosts" checked?={ f.GitAllowPrivateHosts }/>
			<span class="label-text">Allow private hosts</span>
		</label>
	}
}

func portOrDefault(port, defaultPort string) string {
	if port == "" {
		return defaultPort
	}
	return port
}
