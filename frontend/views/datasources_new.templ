package views

import api "github.com/Braidplane/braidplane-core/api-schema/gen/client"

// DataSourceFormFields holds the current field values for the datasource creation form.
type DataSourceFormFields struct {
	HTTPAuth HTTPAuthFormData
	OrgSlug  string
	Name     string
	Slug     string
	// Common
	DSType                    api.DataSourceType
	Host                      string
	Port                      string
	Database                  string
	Username                  string
	Password                  string
	DatabaseAllowPrivateHosts bool

	// PostgreSQL
	SSLMode string

	// MongoDB
	AuthDatabase string

	// BigQuery
	ProjectID          string
	Location           string
	DefaultDataset     string
	MaximumBytesBilled string
	ServiceAccountJSON string

	// Snowflake
	Account               string
	Warehouse             string
	Schema                string
	Role                  string
	SnowflakeAuthType     string
	SnowflakeSelectTables string
	SnowflakeInsertTables string

	// HTTP
	BaseURL               string
	HealthPath            string
	OpenAPIURL            string
	OpenAPIFetchTimeout   string
	BearerToken           string
	TimeoutSeconds        string
	PrivateAppToken       string
	HubSpotReadOnly       bool
	HTTPAllowPrivateHosts bool

	// Git-like
	GitRepoURL                  string
	GitDefaultBranch            string
	GitBasePath                 string
	GitAuthType                 string
	GitUsername                 string
	GitToken                    string
	GitSSHPrivateKey            string
	GitSSHKnownHosts            string
	GitSSHPassphrase            string
	GitAllowPrivateHosts        bool
	AllowPrivateDataSourceHosts bool
}

templ postgresSSLModeField(mode string) {
	<label class="form-control w-full">
		<div class="label py-1"><span class="label-text text-xs">SSL mode</span></div>
		<select class="select select-bordered select-sm w-full" name="sslmode">
			<option value="" selected?={ mode == "" }>Default (verify-full)</option>
			<option value="verify-full" selected?={ mode == "verify-full" }>verify-full</option>
			<option value="verify-ca" selected?={ mode == "verify-ca" }>verify-ca</option>
			<option value="require" selected?={ mode == "require" }>require</option>
			<option value="prefer" selected?={ mode == "prefer" }>prefer</option>
			<option value="allow" selected?={ mode == "allow" }>allow</option>
			<option value="disable" selected?={ mode == "disable" }>disable</option>
		</select>
		<span class="label-text-alt mt-1">Modes other than verify-full require the local development transport exception.</span>
	</label>
}
