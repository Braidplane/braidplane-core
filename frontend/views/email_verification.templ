package views

templ EmailVerificationPage(title string, email string, notice string, returnTo string) {
	@AuthPage(title, false, EmailVerificationPageContent(email, notice, returnTo))
}

templ EmailVerificationPageContent(email string, notice string, returnTo string) {
	<div class="space-y-5 text-center">
		<h1 class="text-2xl font-semibold">Verify your email</h1>
		<p class="text-sm text-base-content/70">We sent a verification link to your inbox.</p>
		if notice != "" {
			<div class="alert alert-success text-sm">{ notice }</div>
		}
		<div class="badge badge-info badge-soft mx-auto h-auto min-h-8 max-w-full break-all px-3 py-2 text-center">Sent to: { email }</div>
		<div class="rounded-lg border border-base-300 bg-base-200/30 p-3 text-left">
			<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Next step</p>
			<p class="mt-2 text-sm text-base-content/80">Open your inbox and click the verification link.</p>
			<p class="text-sm text-base-content/80">You can close this page now.</p>
		</div>
		<div class="grid gap-2">
			<a class="btn btn-primary w-full" href={ templ.URL(AuthReturnURL("/auth/login", returnTo)) }>I&apos;ve clicked the link</a>
			<form method="post" action="/auth/resend-verification" hx-post="/auth/resend-verification" hx-target="main" hx-select="main" hx-swap="innerHTML">
				<input type="hidden" name="email" value={ email }/>
				if returnTo != "" {
					<input type="hidden" name="return_to" value={ returnTo }/>
				}
				<button class="btn btn-outline w-full" type="submit">Resend verification link</button>
			</form>
		</div>
		<p class="text-xs text-base-content/70">Didn&apos;t receive anything? Check your spam folder.</p>
	</div>
}
