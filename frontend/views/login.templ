package views

templ LoginPage(title string, email string, pageError string, pageErrorDetails string, returnTo string, selfServiceRegistrationEnabled bool, invalidField string) {
	@AuthPage(title, true, LoginPageContent(email, pageError, pageErrorDetails, returnTo, selfServiceRegistrationEnabled, invalidField))
}

templ LoginPageContent(email string, pageError string, pageErrorDetails string, returnTo string, selfServiceRegistrationEnabled bool, invalidField string) {
	<div class="space-y-5">
		<header>
			<p class="text-xs font-semibold uppercase tracking-wide text-primary">Account access</p>
			<h1 class="mt-2 text-2xl font-semibold">Sign in</h1>
			<p class="mt-2 text-sm text-base-content/70">Access your organization workspace.</p>
		</header>
		<form class="space-y-3" method="post" action="/auth/login" data-form-feedback>
			if returnTo != "" {
				<input type="hidden" name="return_to" value={ returnTo }/>
			}
			<label class="form-control w-full">
				<div class="label">
					<span class="label-text">Email</span>
				</div>
				<input class="input input-bordered w-full" type="email" name="email" placeholder="name@company.com" value={ email } required maxlength="255" autocomplete="username" { FormFieldError(invalidField == "email", "login-feedback")... }/>
			</label>
			<label class="form-control w-full">
				<div class="label">
					<span class="label-text">Password</span>
				</div>
				<input class="input input-bordered w-full" type="password" name="password" placeholder="••••••••••••" required minlength="8" autocomplete="current-password" { FormFieldError(invalidField == "password", "login-feedback")... }/>
			</label>
			@FormError("login-feedback", pageError, invalidField == "")
			if pageErrorDetails != "" {
				<details class="text-sm"><summary>More details</summary><p class="whitespace-pre-wrap break-words">{ pageErrorDetails }</p></details>
			}
			<div class="text-right text-sm">
				<a class="link link-primary" href="/auth/forgot-password">Forgot password?</a>
			</div>
			<button class="btn btn-primary w-full" type="submit">Sign in</button>
		</form>
		if googleSignInEnabled(ctx) {
			<div class="divider text-xs uppercase tracking-wide text-base-content/50">or</div>
			<a class="btn btn-outline w-full" href={ templ.URL(AuthReturnURL("/api/auth/google", returnTo)) }>Continue with Google</a>
		}
		if selfServiceRegistrationEnabled {
			<p class="text-center text-sm text-base-content/70">
				Don&apos;t have an account?
				<a class="link link-primary" href={ templ.URL(AuthReturnURL("/auth/signup", returnTo)) }>Create one</a>
			</p>
		}
	</div>
}
