package views

templ OrganizationNewPage(shellData AuthenticatedShellData, formData OrganizationCreateFormData) {
	@AuthenticatedShell(shellData, OrganizationNewPageContent(formData))
}

templ OrganizationNewPageContent(formData OrganizationCreateFormData) {
	<div class="mx-auto w-full max-w-3xl py-2">
		<div class="card w-full rounded-xl border border-base-300 bg-base-100 shadow-sm">
			<div class="card-body gap-4">
				<h2 class="text-2xl font-semibold">Create organization</h2>
				<p class="text-sm text-base-content/70">Set up a new workspace for your team.</p>
				<form class="space-y-3" method="post" action="/organizations" hx-post="/organizations" hx-target="body" hx-select="body" hx-swap="outerHTML">
					<label class="form-control w-full">
						<div class="label">
							<span class="label-text">Organization name</span>
						</div>
						<input class="input input-bordered input-lg w-full" type="text" name="name" placeholder="Acme HQ" value={ formData.Name }/>
					</label>
					<label class="form-control w-full">
						<div class="label">
							<span class="label-text">Description (optional)</span>
						</div>
						<textarea class="textarea textarea-bordered textarea-lg w-full resize-y" rows="4" name="description" placeholder="Optional workspace context.">{ formData.Description }</textarea>
					</label>
					@CustomizeIdentifier(formData.Slug)
					<div class="flex flex-col gap-2 pt-1 sm:flex-row sm:justify-end">
						<a class="btn btn-outline w-full sm:w-auto" href="/dashboard">Cancel</a>
						<button class="btn btn-primary w-full sm:w-auto" type="submit">Create Organization</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
