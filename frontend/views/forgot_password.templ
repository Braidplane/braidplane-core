package views

templ ForgotPasswordPage(title string, email string, pageError string, pageErrorDetails string, successMessage string) {
	@AuthPage(title, true, ForgotPasswordPageContent(email, pageError, pageErrorDetails, successMessage))
}

templ ForgotPasswordPageContent(email string, pageError string, pageErrorDetails string, successMessage string) {
	<div class="space-y-5">
		<header>
			<p class="text-xs font-semibold uppercase tracking-wide text-primary">Account recovery</p>
			<h1 class="mt-2 text-2xl font-semibold">Forgot password</h1>
			<p class="mt-2 text-sm text-base-content/70">Enter your email and we will send a reset code.</p>
		</header>
		if successMessage != "" {
			<div class="alert alert-success text-sm" role="status">{ successMessage }</div>
		}
		<form class="space-y-3" method="post" action="/auth/forgot-password" hx-post="/auth/forgot-password" hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" data-form-feedback>
			<label class="form-control w-full">
				<div class="label">
					<span class="label-text">Email</span>
				</div>
				<input class="input input-bordered w-full" type="email" name="email" placeholder="name@company.com" value={ email } autocomplete="email" maxlength="255" required/>
			</label>
			@FormError("forgot-password-feedback", pageError, true)
			if pageErrorDetails != "" {
				<details class="text-sm"><summary>More details</summary><p class="whitespace-pre-wrap break-words">{ pageErrorDetails }</p></details>
			}
			@FormRequestError()
			<button class="btn btn-primary w-full" type="submit">Send reset code</button>
		</form>
		<p class="text-center text-sm text-base-content/70">
			Remembered your password?
			<a class="link link-primary" href="/auth/login">Back to sign in</a>
		</p>
	</div>
}
