package views

templ ForgotPasswordPage(title string, email string, pageError string, pageErrorDetails string, successMessage string) {
	@AuthPage(title, true, ForgotPasswordPageContent(email, pageError, pageErrorDetails, successMessage))
}

templ ForgotPasswordPageContent(email string, pageError string, pageErrorDetails string, successMessage string) {
	if pageError != "" {
		@ErrorPopup("forgot-password-error-popup", pageError, pageErrorDetails)
	}
	<div class="space-y-5">
		<header>
			<p class="text-xs font-semibold uppercase tracking-wide text-primary">Account recovery</p>
			<h1 class="mt-2 text-2xl font-semibold">Forgot password</h1>
			<p class="mt-2 text-sm text-base-content/70">Enter your email and we will send a reset link.</p>
		</header>
		if successMessage != "" {
			<div class="alert alert-success text-sm">{ successMessage }</div>
		}
		<form class="space-y-3" method="post" action="/auth/forgot-password" hx-post="/auth/forgot-password" hx-target="main" hx-select="main" hx-swap="innerHTML">
			<label class="form-control w-full">
				<div class="label">
					<span class="label-text">Email</span>
				</div>
				<input class="input input-bordered w-full" type="email" name="email" placeholder="name@company.com" value={ email }/>
			</label>
			<button class="btn btn-primary w-full" type="submit">Send reset link</button>
		</form>
		<p class="text-center text-sm text-base-content/70">
			Remembered your password?
			<a class="link link-primary" href="/auth/login">Back to sign in</a>
		</p>
	</div>
}
