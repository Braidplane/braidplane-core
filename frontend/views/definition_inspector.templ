package views

import "fmt"
import "strings"

templ DefinitionInspector(org, project string) {
	{{ d := definitionInspectorView(ctx) }}
	<section class="min-w-0 space-y-4" aria-labelledby="definition-inspector" data-definition-inspector hx-history="false">
		<h2 id="definition-inspector" tabindex="-1" aria-describedby="definition-authority definition-selection" class="text-lg font-semibold">Inspect definition</h2>
		<p id="definition-authority" class="text-sm font-medium">{ d.Authority }</p>
		<details>
			<summary class="cursor-pointer text-xs">Version provenance</summary>
			<p class="break-all font-mono text-xs">Spec hash: { func() string { if d.Hash == "" { return "Not recorded" }; return d.Hash }() }</p>
			if d.Commit != "" {
				<p class="break-all text-xs">Recorded Git commit: { d.Commit }</p>
			}
			if d.Created != "" {
				<p class="text-xs">Version created: { d.Created }</p>
			}
		</details>
		if d.Step != "" {
			<p id="definition-selection" class="break-all text-xs">Selected step: { d.Step }</p>
		} else {
			<p id="definition-selection" class="text-xs">Whole authored definition</p>
		}
		if d.Input != "" {
			<p class="break-all text-xs">Named input: { d.Input }</p>
		}
		if d.Port != "" {
			<p class="break-all text-xs">Contract port: { d.Port }</p>
		}
		if d.Notice != "" {
			<p role="status" class="text-xs text-base-content/65">{ d.Notice }</p>
		}
		if d.Message != "" {
			<p role="status" class="text-sm text-base-content/70">{ d.Message }</p>
		} else if d.Spec == nil {
			<p role="status" class="text-sm text-base-content/70">Definition content is unavailable.</p>
		} else {
			<p class="text-xs text-base-content/65">Authored definition; recorded run evidence establishes execution.</p>
			<details>
				<summary class="cursor-pointer text-xs">Definition inspection limits</summary>
				<p class="text-xs text-base-content/65">Authored definition only. Structured fields are a partial projection; Serialized retains all content returned by the authorized API. JSON does not preserve original file comments or formatting. Saved-operation references do not establish historical operation content. Consult recorded run evidence separately for compiled plans and executed targets.</p>
			</details>
			<nav class="flex flex-wrap gap-2" aria-label="Definition views">
				<a class={ "btn btn-sm btn-ghost", templ.KV("btn-active", d.View != "serialized") } data-entity-focus="definition-inspector" href={ templ.URL(definitionHref(ctx, d.Step, d.Input, d.Port, "structured")) }>Structured</a>
				<a class={ "btn btn-sm btn-ghost", templ.KV("btn-active", d.View == "serialized") } data-entity-focus="definition-inspector" href={ templ.URL(definitionHref(ctx, d.Step, d.Input, d.Port, "serialized")) }>Serialized</a>
			</nav>
			<div class={ func() string { if d.Authority == "Executed version" { return "grid min-w-0 gap-4" }; return "grid min-w-0 gap-4 lg:grid-cols-[minmax(10rem,14rem)_minmax(0,1fr)]" }() }>
				<nav id="definition-steps" tabindex="-1" class="min-w-0 max-h-48 overflow-y-auto lg:max-h-[32rem]" aria-label="Definition steps">
					<a class="link link-primary text-sm" data-entity-focus="definition-inspector" href={ templ.URL(definitionHref(ctx, "", "", "", d.View)) }>Whole definition</a>
					<ol class="mt-3 space-y-2">
						for _, step := range d.Steps {
							<li><a class="block break-words rounded px-2 py-2 text-sm hover:bg-base-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary" data-entity-focus="definition-inspector" href={ templ.URL(definitionHref(ctx, step.Slug, "", "", d.View)) } aria-current={ func() string { if step.Slug == d.Step { return "true" }; return "false" }() }>{ fmt.Sprintf("%d. %s",step.SpecPosition,PipelineSpecStepDisplayName(step)) }</a></li>
						}
					</ol>
				</nav>
				<div class="min-w-0 space-y-3">
					if d.SelectionMessage != "" {
						<p role="status">{ d.SelectionMessage }</p>
					} else if d.View == "serialized" {
						<h3 class="text-sm font-semibold">Serialized authored JSON</h3>
						<pre class="max-h-[36rem] max-w-full overflow-auto rounded border border-base-300 bg-base-200/30 p-3 text-xs" tabindex="0" aria-label="Serialized definition"><code>{ d.Serialized }</code></pre>
					} else if d.Selected != nil {
						@DefinitionStep(org, project, *d.Selected)
					} else {
						<p class="text-sm">{ fmt.Sprintf("%d authored steps in original spec order",len(d.Spec.Steps)) }</p>
						if len(d.Steps) != len(d.Spec.Steps) {
							<p role="status" class="text-sm">Some steps are unsupported by Structured. Inspect Serialized for their authored content.</p>
						}
						for _, step := range d.Steps {
							@DefinitionStep(org, project, step)
						}
					}
					<a class="link text-xs" href="#definition-steps">Back to steps</a>
				</div>
			</div>
		}
	</section>
}

templ DefinitionStep(org, project string, step PipelineSpecStepProjection) {
	<div class="min-w-0 border-t border-base-300 pt-3">
		<h3 class="break-words text-base font-semibold">{ PipelineSpecStepDisplayName(step) }</h3>
		@PipelineSpecStepRow(step, true)
		if step.Parameters != "" {
			<h4 class="text-sm font-semibold">Authored parameters and parameter dependencies</h4>
			<p class="text-xs text-base-content/65">$steps references are parameter dependencies, separate from payload inputs. Values are authored declarations; runtime values are not resolved.</p>
			<pre class="mt-2 max-h-48 max-w-full overflow-auto text-xs" tabindex="0">{ step.Parameters }</pre>
		}
		for _, input := range step.Inputs {
			<p class="mt-2 break-words text-sm">Named payload input: <a class="link link-primary" data-entity-focus="definition-inspector" href={ templ.URL(definitionHref(ctx, step.Slug, input.Name, "input", "structured")) }>{ input.Name }</a> ← <a class="link link-primary" data-entity-focus="definition-inspector" href={ templ.URL(definitionHref(ctx, input.FromStep, "", "output", "structured")) }>{ input.FromStep }</a></p>
		}
		for _, slot := range step.ContractSlots {
			if strings.HasPrefix(slot.Label,"Output") {
				<p class="mt-2 text-xs">Producer agreement: output</p>
			} else {
				<p class="mt-2 text-xs">Consumer requirement: { slot.Label }</p>
			}
			if slot.Ref != nil {
				<a class="mt-2 block break-all text-sm link link-primary" data-entity-focus="definition-inspector" href={ templ.URL(definitionContractHref(ctx, org, project, step.Slug, slot)) }>{ slot.Label }: Inspect exact contract revision</a>
			}
		}
	</div>
}
