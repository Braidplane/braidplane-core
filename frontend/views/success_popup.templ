package views

templ SuccessPopup(id string, summary string) {
	<div id={ id } data-success-popup data-auto-dismiss-ms="5000" class="fixed bottom-4 left-4 right-4 z-50 rounded-xl border border-success/30 bg-base-100 p-4 shadow-xl sm:bottom-auto sm:left-auto sm:right-4 sm:top-4 sm:w-[min(92vw,420px)]">
		<div class="flex items-start gap-3">
			<div class="mt-0.5 text-success" aria-hidden="true">&#10003;</div>
			<div class="min-w-0">
				<p class="text-sm font-semibold text-base-content">Success</p>
				<p class="mt-1 text-sm text-base-content/80">{ summary }</p>
			</div>
			<button class="btn btn-ghost btn-xs btn-circle focus:outline-none focus-visible:ring-2 focus-visible:ring-success" type="button" aria-label="Dismiss success" data-popup-dismiss="[data-success-popup]">X</button>
		</div>
	</div>
}
