package views

import "fmt"

import api "github.com/Braidplane/braidplane-core/api-schema/gen/client"

templ AlertsPage(
	shellData AuthenticatedShellData,
	orgSlug string,
	activeTab AlertTab,
	destinations []api.AlertDestination,
	policies []api.AlertPolicy,
	connections []api.NotificationConnection,
	destinationFormData AlertDestinationFormData,
	policyFormData AlertPolicyFormData,
	editFormOverrides AlertEditFormOverrides,
	permissions OrganizationPermissions,
	contentErrorSummary string,
	contentErrorDetails string,
	contentSuccessSummary string,
) {
	@AuthenticatedShell(
		shellData,
		AlertsPageContent(
			orgSlug,
			activeTab,
			destinations,
			policies,
			connections,
			destinationFormData,
			policyFormData,
			editFormOverrides,
			permissions,
			contentErrorSummary,
			contentErrorDetails,
			contentSuccessSummary,
		),
	)
}

templ AlertsPageContent(
	orgSlug string,
	activeTab AlertTab,
	destinations []api.AlertDestination,
	policies []api.AlertPolicy,
	connections []api.NotificationConnection,
	destinationFormData AlertDestinationFormData,
	policyFormData AlertPolicyFormData,
	editFormOverrides AlertEditFormOverrides,
	permissions OrganizationPermissions,
	contentErrorSummary string,
	contentErrorDetails string,
	contentSuccessSummary string,
) {
	<div class="space-y-6" id="alerts-workspace">
		if contentSuccessSummary != "" {
			@SuccessPopup("alerts-success", contentSuccessSummary)
		}
		if contentErrorSummary != "" {
			@ErrorPopup("alerts-error", contentErrorSummary, contentErrorDetails)
		}
		if policyFormData.NotificationReturn != "" {
			<a class="link text-sm" href={ templ.URL(policyFormData.NotificationReturn) }>Back to notification</a>
		}
		if permissions.Can("notifications", "read") {
			<a class="btn btn-outline btn-sm" href={ templ.URL(NotificationsListHref(orgSlug, "", "", NotificationFilters{})) }>View notifications</a>
		}
		@AlertPageTabs(orgSlug, activeTab, destinations, policies, policyFormData)
		if AlertTabFromString(string(activeTab)) == AlertTabPolicies {
			<section class="space-y-4" id={ AlertTabPanelID(AlertTabPolicies) } role="tabpanel" aria-labelledby={ AlertTabID(AlertTabPolicies) }>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div>
						<h2 class="text-base font-semibold text-base-content">Alert policies</h2>
						<p class="mt-1 text-xs text-base-content/70">Policies select notifications and bind delivery destinations.</p>
					</div>
					if policies != nil {
						<span class="badge badge-outline">{ AlertPolicyCountLabel(len(policies)) }</span>
					}
				</div>
				if permissions.Can("alert_destinations", "create") && permissions.Can("alert_destinations", "read") {
					<a class="btn btn-outline btn-sm" href={ templ.URL(AlertSetupHref(orgSlug, AlertTabDestinations, policyFormData)) }>
						if len(destinations) == 0 {
							Create a destination first
						} else {
							Create a destination
						}
					</a>
				}
				if !permissions.Can("alert_destinations", "read") {
					<p class="text-sm text-base-content/70">Destination configuration is restricted. An authorized destination owner must configure routing.</p>
				}
				if permissions.Can("alert_policies", "create") {
					@AlertPolicyForm(
						orgSlug,
						"Create policy",
						"/orgs/"+orgSlug+"/alerts/policies",
						policyFormData,
						destinations,
						false,
						len(destinations) == 0,
						"",
					)
				}
				@AlertPolicyList(orgSlug, destinations, policies, editFormOverrides, permissions)
			</section>
		} else {
			<section class="space-y-4" id={ AlertTabPanelID(AlertTabDestinations) } role="tabpanel" aria-labelledby={ AlertTabID(AlertTabDestinations) }>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div>
						<h2 class="text-base font-semibold text-base-content">Alert destinations</h2>
						<a class="btn btn-outline btn-sm mt-2" href={ templ.URL("/orgs/" + orgSlug + "/alerts/connections") }>Manage notification connections</a>
						<p class="mt-1 text-xs text-base-content/70">Destinations receive deliveries selected by alert policies.</p>
					</div>
					if destinations != nil {
						<span class="badge badge-outline">{ AlertDestinationCountLabel(len(destinations)) }</span>
					}
				</div>
				if permissions.Can("alert_destinations", "create") {
					<form
						class="rounded-xl border border-base-300 bg-base-100 p-4 sm:p-5"
						data-alert-destination-form
						method="post"
						action={ templ.URL("/orgs/" + orgSlug + "/alerts/destinations") }
						hx-post={ "/orgs/" + orgSlug + "/alerts/destinations" }
						hx-target="#alerts-workspace"
						hx-select="#alerts-workspace"
						hx-swap="outerHTML show:none focus-scroll:false"
						data-preserve-scroll
					>
						<div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,.75fr)_minmax(0,.7fr)]">
							<label class="form-control w-full">
								<div class="label py-1"><span class="label-text text-xs">Name</span></div>
								<input class="input input-bordered input-sm w-full" type="text" name="name" placeholder="Ops email" value={ destinationFormData.Name } required/>
							</label>
							@CustomizeIdentifier(destinationFormData.Slug)
							<label class="form-control w-full">
								<div class="label py-1"><span class="label-text text-xs">Type</span></div>
								<select class="select select-bordered select-sm w-full" name="type" data-alert-destination-type required>
									for _, option := range AlertDestinationTypeOptions() {
										<option value={ option.Value } selected?={ destinationFormData.Type == option.Value }>{ option.Label }</option>
									}
								</select>
							</label>
						</div>
						<input type="hidden" name="notification_return" value={ policyFormData.NotificationReturn }/>
						if policyFormData.NotificationReturn != "" {
							<input type="hidden" name="notification_setup" value={ AlertSetupHref(orgSlug, AlertTabPolicies, policyFormData) }/>
							<a class="link text-sm" href={ templ.URL(AlertSetupHref(orgSlug, AlertTabPolicies, policyFormData)) }>Return to policy setup</a>
						}
						@AlertDestinationConfigFields(destinationFormData, connections, "")
						<div class="mt-4 flex justify-end">
							<button class="btn btn-primary btn-sm" type="submit">Create destination</button>
						</div>
					</form>
				}
				@AlertDestinationList(orgSlug, destinations, connections, editFormOverrides, permissions)
			</section>
		}
	</div>
}

templ AlertPageTabs(orgSlug string, activeTab AlertTab, destinations []api.AlertDestination, policies []api.AlertPolicy, form AlertPolicyFormData) {
	<div class="tabs tabs-border" role="tablist" aria-label="Alert management sections">
		<a
			class={ AlertTabClass(activeTab, AlertTabDestinations) }
			id={ AlertTabID(AlertTabDestinations) }
			role="tab"
			aria-selected={ AlertTabAriaSelected(activeTab, AlertTabDestinations) }
			aria-controls={ AlertTabPanelID(AlertTabDestinations) }
			href={ templ.URL(AlertSetupHref(orgSlug, AlertTabDestinations, form)) }
			hx-get={ AlertSetupHref(orgSlug, AlertTabDestinations, form) }
			hx-target="#alerts-workspace"
			hx-select="#alerts-workspace"
			hx-swap="outerHTML show:none focus-scroll:false"
			hx-push-url="true"
		>
			<span>Destinations</span>
			if destinations != nil {
				<span class="badge badge-outline badge-sm ml-2">{ AlertDestinationCountLabel(len(destinations)) }</span>
			}
		</a>
		<a
			class={ AlertTabClass(activeTab, AlertTabPolicies) }
			id={ AlertTabID(AlertTabPolicies) }
			role="tab"
			aria-selected={ AlertTabAriaSelected(activeTab, AlertTabPolicies) }
			aria-controls={ AlertTabPanelID(AlertTabPolicies) }
			href={ templ.URL(AlertSetupHref(orgSlug, AlertTabPolicies, form)) }
			hx-get={ AlertSetupHref(orgSlug, AlertTabPolicies, form) }
			hx-target="#alerts-workspace"
			hx-select="#alerts-workspace"
			hx-swap="outerHTML show:none focus-scroll:false"
			hx-push-url="true"
		>
			<span>Policies</span>
			if policies != nil {
				<span class="badge badge-outline badge-sm ml-2">{ AlertPolicyCountLabel(len(policies)) }</span>
			}
		</a>
	</div>
}

templ AlertDestinationList(orgSlug string, destinations []api.AlertDestination, connections []api.NotificationConnection, editFormOverrides AlertEditFormOverrides, permissions OrganizationPermissions) {
	if destinations == nil {
		<div class="alert alert-error"><span>Alert destinations are unavailable.</span></div>
	} else if len(destinations) == 0 {
		<div class="rounded-xl border border-dashed border-base-300 bg-base-100 p-6 text-center">
			<h3 class="text-base font-semibold text-base-content">No alert destinations</h3>
			<p class="mt-2 text-sm text-base-content/70">Create a destination before binding alert policies.</p>
		</div>
	} else {
		<div class="rounded-xl border border-base-300 bg-base-100 p-4 sm:p-5">
			<div class="hidden grid-cols-[1.1fr_.65fr_1fr_.8fr_.9fr] gap-4 border-b border-base-300 px-2 pb-3 text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:grid">
				<div>Destination</div>
				<div>Type</div>
				<div>Target</div>
				<div>Status</div>
				<div class="text-right">Actions</div>
			</div>
			<div class="divide-y divide-base-300">
				for _, destination := range destinations {
					{{ form := editFormOverrides.DestinationFormDataFor(destination) }}
					<div class="grid gap-3 py-4 lg:grid-cols-[1.1fr_.65fr_1fr_.8fr_.9fr] lg:items-start">
						<div class="min-w-0">
							<p class="font-medium text-base-content">{ destination.Name }</p>
							<p class="break-all font-mono text-xs text-base-content/70">{ string(destination.Slug) }</p>
						</div>
						<div>
							<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Type </span>
							<span class="badge badge-outline">{ AlertDestinationTypeLabel(destination.Type) }</span>
						</div>
						<div class="min-w-0 text-sm text-base-content/80">
							<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Target </span>
							<p class="break-words">{ AlertDestinationTargetLabel(destination, connections) }</p>
						</div>
						<div>
							<span class={ AlertStatusBadgeClass(destination.Enabled) }>{ AlertStatusLabel(destination.Enabled) }</span>
							<p class="mt-1 text-xs text-base-content/60">Updated { AlertTimestampLabel(destination.UpdatedAt) }</p>
						</div>
						<div class="flex flex-wrap gap-2 lg:justify-end">
							<button class="btn btn-outline btn-xs" type="button" aria-controls={ AlertDestinationDetailsPanelID(destination) } aria-expanded="false" data-toggle-target={ AlertDestinationDetailsPanelID(destination) }>Details</button>
							if permissions.Can("alert_destinations", "update") {
								<form
									method="post"
									action={ templ.URL("/orgs/" + orgSlug + "/alerts/destinations/" + string(destination.Slug) + "/test") }
									hx-post={ "/orgs/" + orgSlug + "/alerts/destinations/" + string(destination.Slug) + "/test" }
									hx-target="#alerts-workspace"
									hx-select="#alerts-workspace"
									hx-swap="outerHTML show:none focus-scroll:false"
									data-preserve-scroll
								>
									<button class="btn btn-outline btn-xs" type="submit" disabled?={ !AlertDestinationCanTest(destination, connections) }>Test</button>
								</form>
								<button class="btn btn-ghost btn-xs" type="button" aria-controls={ AlertDestinationEditPanelID(destination) } aria-expanded={ fmt.Sprint(form.ErrorMessage != "") } data-toggle-target={ AlertDestinationEditPanelID(destination) }>Edit</button>
							}
							if permissions.Can("alert_destinations", "delete") {
								<button class="btn btn-error btn-outline btn-xs" type="button" data-protected-action-trigger={ AlertDestinationDeleteModalID(destination) }>Delete</button>
							}
							if !permissions.Can("alert_destinations", "update") && !permissions.Can("alert_destinations", "delete") {
								<span class="text-sm text-base-content/60">No actions</span>
							}
						</div>
						<div id={ AlertDestinationDetailsPanelID(destination) } class="hidden rounded-lg border border-base-300 bg-base-200/35 p-3 lg:col-span-5">
							<div class="grid gap-3 sm:grid-cols-2">
								<div>
									<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Created</p>
									<p class="mt-1 text-sm text-base-content">{ AlertTimestampLabel(destination.CreatedAt) }</p>
								</div>
								<div>
									<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Config</p>
									<p class="mt-1 break-all font-mono text-sm text-base-content">to={ AlertDestinationTargetLabel(destination, connections) }</p>
								</div>
							</div>
						</div>
						if permissions.Can("alert_destinations", "update") {
							<form
								id={ AlertDestinationEditPanelID(destination) }
								class={ "rounded-lg border border-base-300 bg-base-200/35 p-3 lg:col-span-5", templ.KV("hidden", form.ErrorMessage == "") }
								data-form-feedback
								method="post"
								action={ templ.URL("/orgs/" + orgSlug + "/alerts/destinations/" + string(destination.Slug) + "/update") }
								hx-post={ "/orgs/" + orgSlug + "/alerts/destinations/" + string(destination.Slug) + "/update" }
								hx-target="#alerts-workspace"
								hx-select="#alerts-workspace"
								hx-swap="outerHTML show:none focus-scroll:false"
								data-alert-destination-form
								data-dirty-form={ "alert-destination-" + string(destination.Slug) + "-update" }
								data-dirty-unsaved?={ form.ErrorMessage != "" }
								data-preserve-scroll
							>
								<input type="hidden" name="notification_return" value={ editFormOverrides.NotificationReturn }/>
								@AlertDestinationEditFields(form, connections, AlertDestinationEditPanelID(destination)+"-feedback")
								@FormError(AlertDestinationEditPanelID(destination)+"-feedback", form.ErrorMessage, form.InvalidField == "")
								@FormRequestError()
								<div class="mt-4 flex justify-end">
									<button class="btn btn-primary btn-sm" type="submit" data-dirty-submit disabled>Save destination</button>
								</div>
							</form>
						}
						if permissions.Can("alert_destinations", "delete") {
							@AlertDeleteConfirmModal(
								AlertDestinationDeleteModalID(destination),
								"Delete destination",
								destination.Name,
								string(destination.Slug),
								"destination_confirmation",
								"/orgs/"+orgSlug+"/alerts/destinations/"+string(destination.Slug)+"/delete",
								editFormOverrides.NotificationReturn,
							)
						}
					</div>
				}
			</div>
		</div>
	}
}

templ AlertDestinationEditFields(form AlertDestinationFormData, connections []api.NotificationConnection, feedbackID string) {
	<div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,.65fr)_minmax(0,.65fr)]">
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Name</span></div>
			<input class="input input-bordered input-sm w-full" type="text" name="name" value={ form.Name } required { FormFieldError(form.InvalidField == "name", feedbackID)... }/>
		</label>
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Type</span></div>
			<select class="select select-bordered select-sm w-full" name="type" data-alert-destination-type required { FormFieldError(form.InvalidField == "type", feedbackID)... }>
				for _, option := range AlertDestinationTypeOptions() {
					<option value={ option.Value } selected?={ form.Type == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class="flex items-end gap-2 pb-2">
			<input class="checkbox checkbox-sm" type="checkbox" name="enabled" value="on" checked?={ form.Enabled }/>
			<span class="text-sm text-base-content">Enabled</span>
		</label>
	</div>
	@AlertDestinationConfigFields(form, connections, feedbackID)
}

templ AlertPolicyList(orgSlug string, destinations []api.AlertDestination, policies []api.AlertPolicy, editFormOverrides AlertEditFormOverrides, permissions OrganizationPermissions) {
	if policies == nil {
		<div class="alert alert-error"><span>Alert policies are unavailable.</span></div>
	} else if len(policies) == 0 {
		<div class="rounded-xl border border-dashed border-base-300 bg-base-100 p-6 text-center">
			<h3 class="text-base font-semibold text-base-content">No alert policies</h3>
			<p class="mt-2 text-sm text-base-content/70">Create a policy to route matching notification records.</p>
		</div>
	} else {
		<div class="rounded-xl border border-base-300 bg-base-100 p-4 sm:p-5">
			<div class="hidden grid-cols-[1.1fr_.7fr_1fr_1fr_.9fr] gap-4 border-b border-base-300 px-2 pb-3 text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:grid">
				<div>Policy</div>
				<div>Scope</div>
				<div>Notification</div>
				<div>Routing</div>
				<div class="text-right">Actions</div>
			</div>
			<div class="divide-y divide-base-300">
				for _, policy := range policies {
					<div class="grid gap-3 py-4 lg:grid-cols-[1.1fr_.7fr_1fr_1fr_.9fr] lg:items-start">
						<div class="min-w-0">
							<p class="font-medium text-base-content">{ policy.Name }</p>
							<p class="break-all font-mono text-xs text-base-content/70">{ string(policy.Slug) }</p>
							<span class={ AlertStatusBadgeClass(policy.Enabled) }>{ AlertStatusLabel(policy.Enabled) }</span>
						</div>
						<div class="text-sm text-base-content/80">
							<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Scope </span>
							<p>{ AlertPolicyScopeLabel(policy.Scope) }</p>
							<p class="mt-1 break-all font-mono text-xs text-base-content/60">{ AlertPolicyScopeTargetLabel(policy) }</p>
						</div>
						<div class="text-sm text-base-content/80">
							<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Notification </span>
							<p>{ AlertPolicyNotificationTypeLabel(policy) }</p>
							<div class="mt-1 flex flex-wrap gap-1">
								<span class={ AlertPolicySeverityBadgeClass(policy) }>{ AlertPolicySeverityLabel(policy) }</span>
								<span class={ AlertPolicyLifecycleBadgeClass(policy) }>{ AlertPolicyLifecycleLabel(policy) }</span>
							</div>
						</div>
						<div class="min-w-0 text-sm text-base-content/80">
							<span class="text-xs font-semibold uppercase tracking-wide text-base-content/60 lg:hidden">Routing </span>
							<p>{ AlertPolicySourceLabel(policy) }</p>
							<p class="break-all font-mono text-xs">{ AlertPolicyDestinationLabel(policy.DestinationSlugs) }</p>
							if permissions.Can("alert_destinations", "read") {
								for _, destination := range policy.DestinationSlugs {
									<a class="link block break-all text-xs" href={ templ.URL(AlertJourneyHref(orgSlug, AlertTabDestinations, editFormOverrides.NotificationReturn, destination)) }>Destination: { destination }</a>
								}
							}
						</div>
						<div class="flex flex-wrap gap-2 lg:justify-end">
							if permissions.Can("notifications", "read") {
								<a class="btn btn-outline btn-xs" href={ templ.URL(AlertPolicyNotificationsHref(orgSlug, policy)) }>View condition notifications</a>
							}
							<button class="btn btn-outline btn-xs" type="button" aria-controls={ AlertPolicyDetailsPanelID(policy) } aria-expanded="false" data-toggle-target={ AlertPolicyDetailsPanelID(policy) }>Details</button>
							if permissions.Can("alert_policies", "update") {
								<button class="btn btn-ghost btn-xs" type="button" aria-controls={ AlertPolicyEditPanelID(policy) } aria-expanded="false" data-toggle-target={ AlertPolicyEditPanelID(policy) }>Edit</button>
							}
							if permissions.Can("alert_policies", "delete") {
								<button class="btn btn-error btn-outline btn-xs" type="button" data-protected-action-trigger={ AlertPolicyDeleteModalID(policy) }>Delete</button>
							}
							if !permissions.Can("alert_policies", "update") && !permissions.Can("alert_policies", "delete") {
								<span class="text-sm text-base-content/60">No actions</span>
							}
						</div>
						<div id={ AlertPolicyDetailsPanelID(policy) } class="hidden rounded-lg border border-base-300 bg-base-200/35 p-3 lg:col-span-5">
							<div class="grid gap-3 sm:grid-cols-3">
								<div>
									<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Created</p>
									<p class="mt-1 text-sm text-base-content">{ AlertTimestampLabel(policy.CreatedAt) }</p>
								</div>
								<div>
									<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Updated</p>
									<p class="mt-1 text-sm text-base-content">{ AlertTimestampLabel(policy.UpdatedAt) }</p>
								</div>
								<div>
									<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Lifecycle</p>
									<p class="mt-1"><span class={ AlertPolicyLifecycleBadgeClass(policy) }>{ AlertPolicyLifecycleLabel(policy) }</span></p>
								</div>
							</div>
						</div>
						if permissions.Can("alert_policies", "update") {
							{{ form := editFormOverrides.PolicyFormDataFor(policy) }}
							{{ form.NotificationReturn = editFormOverrides.NotificationReturn }}
							<div id={ AlertPolicyEditPanelID(policy) } class="hidden rounded-lg border border-base-300 bg-base-200/35 p-3 lg:col-span-5">
								@AlertPolicyForm(
									orgSlug,
									"Save policy",
									"/orgs/"+orgSlug+"/alerts/policies/"+string(policy.Slug)+"/update",
									form,
									destinations,
									true,
									len(destinations) == 0,
									"alert-policy-"+string(policy.Slug)+"-update",
								)
							</div>
						}
						if permissions.Can("alert_policies", "delete") {
							@AlertDeleteConfirmModal(
								AlertPolicyDeleteModalID(policy),
								"Delete policy",
								policy.Name,
								string(policy.Slug),
								"policy_confirmation",
								"/orgs/"+orgSlug+"/alerts/policies/"+string(policy.Slug)+"/delete",
								editFormOverrides.NotificationReturn,
							)
						}
					</div>
				}
			</div>
		</div>
	}
}

templ AlertPolicyForm(orgSlug string, buttonLabel string, actionURL string, form AlertPolicyFormData, destinations []api.AlertDestination, includeEnabled bool, disableSubmit bool, dirtyFormID string) {
	{{ renderForm := AlertPolicyFormDataForRender(form) }}
	{{ selectorTargetID := AlertPolicyFormSelectorID(renderForm, includeEnabled) }}
	<form
		class={ AlertPolicyFormClass(includeEnabled) }
		method="post"
		action={ templ.URL(actionURL) }
		hx-post={ actionURL }
		hx-target="#alerts-workspace"
		hx-select="#alerts-workspace"
		hx-swap="outerHTML show:none focus-scroll:false"
		{ AlertPolicyFormAttrs(dirtyFormID, disableSubmit)... }
		data-alert-policy-form
		data-preserve-scroll
	>
		<input type="hidden" name="notification_return" value={ form.NotificationReturn }/>
		@AlertPolicyFormFields(orgSlug, selectorTargetID, renderForm, destinations, includeEnabled)
		<div class="mt-4 border-t border-base-300 pt-3 text-sm">
			<p class="font-semibold">Policy review</p>
			<p class="mt-1 break-words" data-alert-policy-review>Review the selected condition, scope, lifecycle, source restrictions and destinations before saving.</p>
			<p class="mt-2 text-xs text-base-content/70">An enabled policy selects future matching delivery; disabled policies do not. It does not send a test, resend historical notifications or prove delivery. More-specific policies win per destination.</p>
		</div>
		<div class="mt-4 flex justify-end">
			if AlertPolicyUsesDirtySubmit(dirtyFormID, disableSubmit) {
				<button class="btn btn-primary btn-sm" type="submit" data-dirty-submit disabled>{ buttonLabel }</button>
			} else {
				<button class="btn btn-primary btn-sm" type="submit" disabled?={ disableSubmit }>{ buttonLabel }</button>
			}
		</div>
	</form>
}

templ AlertPolicyFormFields(orgSlug string, selectorTargetID string, form AlertPolicyFormData, destinations []api.AlertDestination, includeEnabled bool) {
	@AlertPolicySelectorFields(orgSlug, selectorTargetID, form, AlertPolicyDynamicOptions{})
	<div class="mt-4 grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,.75fr)]">
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Name</span></div>
			<input class="input input-bordered input-sm w-full" type="text" name="name" placeholder="Critical pipeline failures" value={ form.Name } required/>
		</label>
		if includeEnabled {
			<input type="hidden" name="slug" value={ form.Slug }/>
		}
		if !includeEnabled {
			@CustomizeIdentifier(form.Slug)
		}
		if includeEnabled {
			<label class="flex items-end gap-2 pb-2">
				<input class="checkbox checkbox-sm" type="checkbox" name="enabled" value="on" checked?={ form.Enabled }/>
				<span class="text-sm text-base-content">Enabled</span>
			</label>
		}
	</div>
	<div class="mt-4">
		<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Destinations</p>
		if destinations == nil {
			<p class="mt-2 text-sm text-base-content/70">Destination choices are restricted or unavailable.</p>
		} else if len(destinations) == 0 {
			<div class="mt-2 flex flex-col gap-3 rounded-lg border border-warning/35 bg-warning/10 px-3 py-3 text-sm text-base-content sm:flex-row sm:items-center sm:justify-between">
				<span>No alert destinations exist yet.</span>
			</div>
		} else {
			<div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
				for _, destination := range destinations {
					<label class="flex min-w-0 items-center gap-2 rounded-lg border border-base-300 bg-base-200/30 px-3 py-2">
						<input class="checkbox checkbox-sm" type="checkbox" name="destination_slug" value={ string(destination.Slug) } data-destination-label={ destination.Name } data-destination-enabled={ AlertStatusLabel(destination.Enabled) } checked?={ AlertPolicyHasDestination(form, destination.Slug) }/>
						<span class="text-xs text-base-content/60">{ AlertStatusLabel(destination.Enabled) }</span>
						<span class="min-w-0">
							<span class="block truncate text-sm font-medium text-base-content">{ destination.Name }</span>
							<span class="block truncate font-mono text-xs text-base-content/60">{ string(destination.Slug) }</span>
						</span>
					</label>
				}
			</div>
		}
	</div>
}

templ AlertPolicySelectorFields(orgSlug string, selectorTargetID string, form AlertPolicyFormData, dynamicOptions AlertPolicyDynamicOptions) {
	<div id={ selectorTargetID } data-alert-policy-selector hx-sync="closest form:replace" { AlertPolicySelectorLoadAttrs(orgSlug, selectorTargetID, form, dynamicOptions)... }>
		@AlertPolicySelectorFieldsBody(orgSlug, selectorTargetID, form, dynamicOptions)
	</div>
}

templ AlertPolicySelectorFieldsBody(orgSlug string, selectorTargetID string, form AlertPolicyFormData, dynamicOptions AlertPolicyDynamicOptions) {
	{{ form = AlertPolicyFormDataForRender(form) }}
	{{ options := AlertPolicySelectorOptionsFor(form, dynamicOptions) }}
	if RecencyAvailable(ctx) {
		{{ options.NotificationTypes = append(options.NotificationTypes, alertFormOption{Value: string(api.NotificationTypePipelineFreshnessSLABreached), Label: "Successful-run recency breached"}) }}
	}
	<input type="hidden" name="selector_target_id" value={ selectorTargetID }/>
	<div>
		<p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Policy type</p>
		<div class="mt-2 grid gap-2 md:grid-cols-3">
			for _, option := range AlertPolicyKindOptions() {
				<label class={ AlertPolicyKindCardClass(form, option.Value) }>
					<input class="radio radio-primary radio-sm mt-0.5 shrink-0" type="radio" name="policy_kind" value={ option.Value } checked?={ string(AlertPolicyKindForForm(form)) == option.Value } required hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select"/>
					<span class="min-w-0">
						<span class="block text-sm font-semibold text-base-content">{ option.Label }</span>
						<span class="mt-1 block text-xs leading-5 text-base-content/65">{ option.Help }</span>
					</span>
				</label>
			}
		</div>
	</div>
	<div class="mt-3 grid gap-3 lg:grid-cols-3">
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Scope</span></div>
			<select class="select select-bordered select-sm w-full" name="scope" required data-alert-policy-scope-select hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select">
				for _, option := range AlertPolicyScopeOptions() {
					<option value={ option.Value } selected?={ form.Scope == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class={ AlertPolicyScopeFieldClass(AlertPolicyProjectScopeEnabled(form)) } data-alert-policy-scope-fields="project,project_environment">
			<div class="label py-1"><span class="label-text text-xs">Project</span></div>
			<select class="select select-bordered select-sm w-full" name="project_slug" required?={ options.ProjectEnabled } disabled?={ AlertPolicyProjectSelectDisabled(form) } hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select">
				for _, option := range options.Projects {
					<option value={ option.Value } selected?={ form.ProjectSlug == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class={ AlertPolicyScopeFieldClass(AlertPolicyEnvironmentScopeEnabled(form)) } data-alert-policy-scope-fields="project_environment">
			<div class="label py-1"><span class="label-text text-xs">Environment</span></div>
			<select class="select select-bordered select-sm w-full" name="environment_slug" required?={ options.EnvironmentEnabled } disabled?={ AlertPolicyEnvironmentSelectDisabled(form) } hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select">
				for _, option := range options.Environments {
					<option value={ option.Value } selected?={ form.EnvironmentSlug == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
	</div>
	<div class="mt-3 grid gap-3 lg:grid-cols-3">
		if AlertPolicyShowsNotificationType(form) {
			<label class="form-control w-full">
				<div class="label py-1"><span class="label-text text-xs">Notification type</span></div>
				if form.NotificationType == string(api.NotificationTypePipelineFreshnessSLABreached) && !RecencyAvailable(ctx) {
					<p class="text-sm">Successful-run recency is currently unavailable. This existing condition is preserved when disabling the policy.</p>
					<input type="hidden" name="notification_type" value={ form.NotificationType }/>
				} else {
					<select class="select select-bordered select-sm w-full" name="notification_type" hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select">
						for _, option := range options.NotificationTypes {
							if option.Value != "" {
								<option value={ option.Value } selected?={ form.NotificationType == option.Value }>{ option.Label }</option>
							}
						}
					</select>
				}
			</label>
		}
		if AlertPolicyShowsSeverity(form) {
			<label class="form-control w-full">
				<div class="label py-1"><span class="label-text text-xs">Severity</span></div>
				<select class="select select-bordered select-sm w-full" name="severity">
					for _, option := range options.Severities {
						if option.Value != "" || AlertPolicyShowsNotificationType(form) {
							<option value={ option.Value } selected?={ form.Severity == option.Value }>{ option.Label }</option>
						}
					}
				</select>
			</label>
		}
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Lifecycle</span></div>
			<select class="select select-bordered select-sm w-full" name="lifecycle_state">
				for _, option := range options.LifecycleStates {
					<option value={ option.Value } selected?={ form.LifecycleState == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Source entity</span></div>
			<select class="select select-bordered select-sm w-full" name="source_kind" hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select">
				for _, option := range options.SourceKinds {
					<option value={ option.Value } selected?={ form.SourceKind == option.Value }>{ option.Label }</option>
				}
			</select>
		</label>
		if AlertPolicyShowsSourceAction(form) {
			<label class="form-control w-full">
				<div class="label py-1"><span class="label-text text-xs">Source action</span></div>
				<select class="select select-bordered select-sm w-full" name="source_action" hx-get={ AlertPolicySelectorOptionsHref(orgSlug) } hx-target={ "#" + selectorTargetID } hx-select={ "#" + selectorTargetID } hx-include="closest form" hx-trigger="change" hx-swap="outerHTML" hx-disinherit="hx-select">
					for _, option := range options.SourceActions {
						<option value={ option.Value } selected?={ form.SourceAction == option.Value }>{ option.Label }</option>
					}
				</select>
			</label>
		}
		if AlertPolicyShowsSourceRef(form) {
			<label class="form-control w-full">
				<div class="label py-1"><span class="label-text text-xs">{ AlertPolicySourceRefLabel() }</span></div>
				<select class="select select-bordered select-sm w-full font-mono" name="source_ref">
					for _, option := range options.SourceRefs {
						<option value={ option.Value } selected?={ form.SourceRef == option.Value }>{ option.Label }</option>
					}
				</select>
			</label>
		}
	</div>
}

func AlertPolicyFormClass(includeEnabled bool) string {
	return "rounded-xl border border-base-300 bg-base-100 p-4 sm:p-5" + func() string {
		if includeEnabled {
			return " border-dashed"
		}
		return ""
	}()
}

templ AlertDeleteConfirmModal(modalID string, title string, name string, resourceSlug string, confirmationField string, actionURL string, notificationReturn string) {
	<dialog class="modal" id={ modalID } data-protected-action-modal data-confirm-slug={ resourceSlug }>
		<div class="modal-box max-w-lg border border-error/35 bg-base-100 p-0">
			<div class="border-b border-error/25 bg-error/10 px-5 py-4">
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div>
						<h3 class="text-lg font-semibold text-base-content">{ title }</h3>
						<p class="mt-1 text-sm text-base-content/70">{ name }</p>
					</div>
					<span class="badge badge-outline max-w-full break-all">{ resourceSlug }</span>
				</div>
			</div>
			<form
				class="px-5 py-4"
				method="post"
				action={ templ.URL(actionURL) }
				hx-post={ actionURL }
				hx-target="#alerts-workspace"
				hx-select="#alerts-workspace"
				hx-swap="outerHTML show:none focus-scroll:false"
				data-preserve-scroll
			>
				<input type="hidden" name="notification_return" value={ notificationReturn }/>
				<label class="form-control w-full">
					<div class="label py-1">
						<span class="label-text text-xs">Type <span class="font-mono font-semibold text-error">{ resourceSlug }</span> to confirm</span>
					</div>
					<input
						class="input input-bordered w-full font-mono"
						type="text"
						name={ confirmationField }
						autocomplete="off"
						placeholder={ resourceSlug }
						required
						data-protected-confirm-input
						data-confirm-slug={ resourceSlug }
					/>
				</label>
				<div class="modal-action mt-5">
					<button class="btn btn-ghost btn-sm" type="button" data-protected-action-close={ modalID }>Cancel</button>
					<button class="btn btn-error btn-sm" type="submit" data-protected-confirm-submit disabled aria-disabled="true">Delete</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button type="submit">close</button>
		</form>
	</dialog>
}

templ AlertDestinationConfigFields(form AlertDestinationFormData, connections []api.NotificationConnection, feedbackID string) {
	<div class={ "mt-3", templ.KV("hidden", form.Type!="email") } data-alert-destination-fields="email">
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Recipients</span></div>
			<input class="input input-bordered input-sm w-full" type="email" name="to" value={ form.To } multiple disabled?={ form.Type!="email" } { FormFieldError(form.InvalidField == "to", feedbackID)... }/>
		</label>
	</div>
	<div class={ "mt-3", templ.KV("hidden", form.Type!="slack") } data-alert-destination-fields="slack">
		<label class="form-control w-full">
			<div class="label py-1"><span class="label-text text-xs">Slack connection</span></div>
			<select class="select select-bordered select-sm w-full" name="connection_slug" { FormFieldError(form.InvalidField == "connection_slug", feedbackID)... } required?={ form.Type=="slack" } disabled?={ form.Type!="slack" }>
				<option value="">Select an active connection</option>
				if form.ConnectionSlug!="" && !AlertConnectionListed(connections,form.ConnectionSlug) {
					<option value={ form.ConnectionSlug } selected>{ form.ConnectionSlug } (unavailable)</option>
				}
				for _, connection := range connections {
					if connection.Provider==api.NotificationProviderSlack {
						<option value={ connection.Slug } selected?={ connection.Slug==form.ConnectionSlug } disabled?={ connection.Status!=api.CredentialStatusActive && connection.Slug!=form.ConnectionSlug }>{ connection.Name } · { NotificationConnectionDescription(connection) } ({ string(connection.Status) })</option>
					}
				}
			</select>
		</label>
		if connections==nil {
			<p class="mt-1 text-xs text-error">Connection status is unavailable. Reload before enabling a destination.</p>
		}
		if len(connections)==0 {
			<p class="mt-1 text-xs text-base-content/70">Connect Slack using Manage notification connections, then return to select it.</p>
		}
	</div>
}
