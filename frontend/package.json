{
    "name": "braidplane-js-tests",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "vitest run --config vitest.config.js",
        "build:css": "tailwindcss -c tailwind.config.cjs -i ./assets/css/app.tailwind.css -o ./assets/css/app.css --minify",
        "lint:js": "biome check --error-on-warnings",
        "fmt:js": "biome format --write",
        "test:e2e": "PW_DISABLE_TS_ESM=1 node ./node_modules/@playwright/test/cli.js test",
        "test:e2e:evidence": "PLAYWRIGHT_E2E_EVIDENCE=1 PW_DISABLE_TS_ESM=1 node ./node_modules/@playwright/test/cli.js test --project=chromium",
        "test:e2e:headed": "PW_DISABLE_TS_ESM=1 node ./node_modules/@playwright/test/cli.js test --headed",
        "e2e:install": "npx playwright install chromium firefox webkit",
        "e2e:install-with-deps": "npx playwright install --with-deps chromium firefox webkit"
    },
    "overrides": {
        "@tailwindcss/node": {
            "lightningcss": "1.33.0"
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/cli": "^4.3.3",
        "daisyui": "^5.7.47",
        "jsdom": "^30.1.2",
        "tailwindcss": "^4.2.1",
        "vitest": "^4.1.11"
    }
}
