meta {
  name: 05 Create User 2
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "full_name": "User Two",
    "email": "user-two-{{timestamp}}@example.com",
    "password": "SecurePass123!"
  }
}

script:pre-request {
  bru.cookies.jar().clear();
  bru.deleteVar("user2Slug");
  bru.deleteVar("user2Email");
  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status !== 201) {
    bru.runner.stopExecution();
    throw new Error(`05 Create User 2 failed with status ${res.status}`);
  }

  if (!res.body?.slug || !res.body?.email) {
    bru.runner.stopExecution();
    throw new Error("05 Create User 2 did not return slug and email");
  }

  bru.setVar("user2Slug", res.body.slug);
  bru.setVar("user2Email", res.body.email);
}

tests {
  test("should create user 2 successfully", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property('slug');
  });
}
