meta {
  name: 08 Create Org 2
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/organizations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Organization Two",
    "slug": "org-two-{{timestamp}}"
  }
}

script:pre-request {
  bru.deleteVar("orgSlug2");
  req.setHeader("Cookie", `${bru.getVar("user2CookieName")}=${bru.getVar("user2CookieValue")}`);
  req.setHeader("X-CSRF-Token", bru.getVar("user2CSRFToken"));
  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status !== 201) {
    bru.runner.stopExecution();
    throw new Error(`08 Create Org 2 failed with status ${res.status}`);
  }

  if (!res.body?.slug) {
    bru.runner.stopExecution();
    throw new Error("08 Create Org 2 did not return slug");
  }

  bru.setVar("orgSlug2", res.body.slug);
}

tests {
  test("should create org 2 successfully", function() {
    expect(res.status).to.equal(201);
  });
}
