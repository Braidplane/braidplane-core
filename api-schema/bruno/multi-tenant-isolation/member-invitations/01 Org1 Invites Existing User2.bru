meta {
  name: 01 Org1 Invites Existing User2
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug1}}/member-invitations
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{user2Email}}",
    "role": "viewer"
  }
}

script:pre-request {
  if (!bru.getVar("orgSlug1")) {
    throw new Error("orgSlug1 not set - run setup first");
  }
  if (!bru.getVar("user1CookieName") || !bru.getVar("user1CookieValue")) {
    throw new Error("user1 session not set - run setup first");
  }
  if (!bru.getVar("user2Email")) {
    throw new Error("user2Email not set - run setup first");
  }

  bru.deleteVar("existingUserInvitationSlug");
  bru.deleteVar("existingUserInvitationToken");
  req.setHeader("Cookie", `${bru.getVar("user1CookieName")}=${bru.getVar("user1CookieValue")}`);
  req.setHeader("X-CSRF-Token", bru.getVar("user1CSRFToken"));
}

script:post-response {
  if (res.status !== 201) {
    bru.runner.stopExecution();
    throw new Error(`01 Org1 Invites Existing User2 failed with status ${res.status}`);
  }
  bru.setVar("existingUserInvitationSlug", res.body.slug);
}

tests {
  test("should create a pending invitation by email", function() {
    expect(res.status).to.equal(201);
    expect(res.body.email).to.equal(bru.getVar("user2Email"));
    expect(res.body.organization_slug).to.equal(bru.getVar("orgSlug1"));
    expect(res.body.role).to.equal("viewer");
    expect(res.body.status).to.equal("pending");
  });

  test("should not expose token material", function() {
    expect(res.body).to.not.have.property("token");
    expect(res.body).to.not.have.property("token_hash");
    expect(res.body.accepted_user_slug).to.equal(null);
  });
}
