meta {
  name: 08 Org2 User Cannot Get Org1 Run
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug1}}/projects/{{pipelineProjectSlug}}/environments/prod/runs/cross-org-run
  auth: inherit
}

script:pre-request {
  bru.cookies.jar().clear();
  req.setHeader("Cookie", `${bru.getVar("user2CookieName")}=${bru.getVar("user2CookieValue")}`);
}

tests {
  test("rejects cross-organization run reads", function() {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal("AUTH_FORBIDDEN");
  });
}
