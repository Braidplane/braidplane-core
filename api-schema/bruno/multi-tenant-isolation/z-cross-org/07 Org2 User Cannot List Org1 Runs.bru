meta {
  name: 07 Org2 User Cannot List Org1 Runs
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug1}}/projects/{{pipelineProjectSlug}}/environments/prod/runs
  auth: inherit
}

script:pre-request {
  bru.cookies.jar().clear();
  req.setHeader("Cookie", `${bru.getVar("user2CookieName")}=${bru.getVar("user2CookieValue")}`);
}

tests {
  test("rejects cross-organization run listing", function() {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal("AUTH_FORBIDDEN");
  });
}
