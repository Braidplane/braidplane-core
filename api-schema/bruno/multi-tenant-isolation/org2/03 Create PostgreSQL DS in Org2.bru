meta {
  name: 03 Create PostgreSQL DS in Org2
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug2}}/data-sources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Org2 PostgreSQL",
    "slug": "org2-postgres-{{timestamp}}",
    "type": "postgres",
    "config": {
      "host": "localhost",
      "port": {{postgresPort}},
      "database": "braidplane",
      "ssl_mode": "disable",
      "allow_private_hosts": true
    },
    "credentials": {
      "username": "postgres",
      "password": "postgres"
    }
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
  if (!bru.getVar("orgSlug2")) {
    throw new Error("orgSlug2 not set - run setup first");
  }
  if (!bru.getEnvVar("postgresPort") && !bru.getVar("postgresPort")) {
    throw new Error("postgresPort not set");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("org2DSSlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
