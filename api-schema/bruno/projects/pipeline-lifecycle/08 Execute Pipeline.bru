meta {
  name: 08 Execute Pipeline
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/environments/{{environmentSlug}}/pipelines/{{pipelineSlug}}:execute
  body: json
  auth: inherit
}

body:json {
  {
    "run_slug": "{{pipelineRunSlug}}"
  }
}

script:pre-request {
  bru.setVar("pipelineRunSlug", `bruno-git-run-${Date.now()}`);
}

tests {
  test("accepts execution of the deployed Git version", function() {
    expect(res.status).to.equal(202);
    expect(res.body.metadata.run_slug).to.equal(bru.getVar("pipelineRunSlug"));
    expect(res.body.metadata.pipeline_slug).to.equal(bru.getVar("pipelineSlug"));
  });
}
