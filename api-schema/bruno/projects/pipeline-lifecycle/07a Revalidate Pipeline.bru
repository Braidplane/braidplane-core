meta {
  name: 07a Revalidate Pipeline
  type: http
  seq: 7.5
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/environments/{{environmentSlug}}/pipelines/{{pipelineSlug}}:revalidate
  body: none
  auth: inherit
}

tests {
  test("validates the reconciled spec and its environment bindings", function() {
    expect(res.status).to.equal(200);
    expect(res.body.pipeline_slug).to.equal(bru.getVar("pipelineSlug"));
    expect(res.body.environment_slug).to.equal(bru.getVar("environmentSlug"));
    expect(res.body.valid).to.equal(true);
    expect((res.body.diagnostics || []).filter(item => item.severity === "error")).to.have.length(0);
  });
}
