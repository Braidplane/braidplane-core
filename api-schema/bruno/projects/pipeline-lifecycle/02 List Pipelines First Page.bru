meta {
  name: 02 List Pipelines First Page
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/pipelines?limit=1
  auth: inherit
}

tests {
	test("returns the bounded pagination shape", function() {
		expect(res.status).to.equal(200);
		expect(res.body.pipelines).to.have.length(1);
		expect(res.body.pipelines[0].slug).to.equal(bru.getVar("pipelineSlug"));
		expect(res.body.has_more).to.equal(false);
		expect(res.body.next_cursor === undefined || res.body.next_cursor === null).to.equal(true);
		expect(res.body.prev_cursor === undefined || res.body.prev_cursor === null).to.equal(true);
	});
}
