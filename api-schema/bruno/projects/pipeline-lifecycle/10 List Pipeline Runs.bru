meta {
  name: 10 List Pipeline Runs
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/environments/{{environmentSlug}}/runs?pipeline_slug={{pipelineSlug}}
  auth: inherit
}

tests {
  test("lists the Git pipeline run", function() {
    expect(res.status).to.equal(200);
    expect(res.body.runs.some(run => run.run_slug === bru.getVar("pipelineRunSlug"))).to.equal(true);
  });
}
