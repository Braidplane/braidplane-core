meta {
  name: 10a Inspect Logical Completion
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/environments/{{environmentSlug}}/runs/{{pipelineRunSlug}}/completion
  auth: inherit
}

tests {
  test("inspects persisted logical closure without creating a child", function() {
    expect(res.status).to.equal(200);
    expect(res.body.root_run_slug).to.equal(bru.getVar("pipelineRunSlug"));
    expect(res.body.closed).to.equal(true);
    expect(res.body.outcome).to.equal("succeeded");
    expect(res.body.final_attempt_run_slug).to.equal(bru.getVar("pipelineRunSlug"));
    expect(res.body.waiting_for_retry).to.equal(false);
    expect(res.body.attempts).to.be.an("array").and.not.empty;
    expect(res.body.children).to.be.an("array");
    expect(res.body.parent).to.equal(null);
  });
}
