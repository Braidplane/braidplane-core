meta {
  name: 01 Create Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sessions
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:pre-request {
  bru.cookies.jar().clear();
  bru.setVar("userEmail", bru.getEnvVar("userEmail"));
  bru.setVar("userPassword", bru.getEnvVar("userPassword"));
  bru.setVar("orgSlug", bru.getEnvVar("orgSlug"));
  bru.setVar("projectSlug", bru.getEnvVar("projectSlug"));
  bru.setVar("environmentSlug", bru.getEnvVar("environmentSlug"));
  bru.setVar("pipelineSlug", bru.getEnvVar("pipelineSlug"));
}

tests {
  test("creates a seeded-owner session", function() {
    expect(res.status).to.equal(200);
  });
}
