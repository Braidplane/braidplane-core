meta {
  name: 02 Read Pipeline Before Reconcile
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/pipelines/{{pipelineSlug}}
  auth: inherit
}

script:post-response {
  const csrfToken = res.headers['x-csrf-token'] || res.headers['X-CSRF-Token'];
  bru.setVar("csrfToken", csrfToken);
}

tests {
  test("keeps the materialized pipeline until reconcile", function() {
    expect(res.status).to.equal(200);
    expect(bru.getVar("csrfToken")).to.be.a("string").and.not.empty;
  });
}
