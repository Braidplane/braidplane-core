meta {
  name: 03 Reconcile Deleted Pipeline
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/pipelines:reconcile
  body: json
  auth: inherit
}

body:json {
  {
    "dry_run": false
  }
}

tests {
  test("removes only the pipeline deleted in Git", function() {
    expect(res.status).to.equal(200);
    expect(res.body.source.commit).to.equal(bru.getEnvVar("expectedGitCommitSHA"));
    expect(res.body.summary.deleted).to.equal(1);
    expect(res.body.deleted.some(item => item.pipeline_slug === bru.getVar("pipelineSlug"))).to.equal(true);
    expect(res.body.failures).to.have.length(0);
  });
}
