meta {
  name: 05 Update Project
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Operations Workspace Renamed"
  }
}

script:pre-request {
  const jar = bru.cookies.jar();
  jar.clear();
  req.setHeader("Cookie", `${bru.getVar("sessionCookieName")}=${bru.getVar("sessionCookieValue")}`);

  if (!bru.getVar("projectSlug")) {
    bru.runner.stopExecution();
    throw new Error("projectSlug not set - run '03 Create Project' first");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return updated project", function() {
    const body = res.getBody();
    expect(body.slug).to.equal(bru.getVar("projectSlug"));
    expect(body.name).to.equal("Operations Workspace Renamed");
    expect(body.pipeline_backend).to.equal(null);
  });
}
