meta {
  name: 04 Get Project
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}
  auth: inherit
}

script:pre-request {
  const jar = bru.cookies.jar();
  jar.clear();
  req.setHeader("Cookie", `${bru.getVar("sessionCookieName")}=${bru.getVar("sessionCookieValue")}`);

  if (!bru.getVar("projectSlug")) {
    bru.runner.stopExecution();
    throw new Error("projectSlug not set - run '03 Create Project' first");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return requested project", function() {
    expect(res.body.slug).to.equal(bru.getVar("projectSlug"));
    expect(res.body).to.have.property("pipeline_backend");
    expect(res.body.pipeline_backend).to.equal(null);
  });
}
