meta {
  name: 03 Reconcile Restored Pipeline
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/pipelines:reconcile
  body: json
  auth: inherit
}

body:json {
  {
    "dry_run": false
  }
}

tests {
  test("rematerializes the pipeline from the restored Git commit", function() {
    expect(res.status).to.equal(200);
    expect(res.body.source.commit).to.equal(bru.getEnvVar("expectedGitCommitSHA"));
    expect(res.body.synced.some(item => item.pipeline_slug === bru.getVar("pipelineSlug"))).to.equal(true);
    expect(res.body.failures).to.have.length(0);
  });
}
