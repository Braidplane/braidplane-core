meta {
  name: 04a Create PostgreSQL Query Required Param
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{postgresDataSourceSlug}}/queries
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test PostgreSQL Query Required Param",
    "slug": "test-postgres-required-{{timestamp}}",
    "description": "Required parameter validation test",
    "query_statement": {
      "type": "postgres",
      "sql": "SELECT {{user_id}}::int as user_id"
    },
    "parameters": [
      {
        "name": "user_id",
        "data_type": "integer",
        "required": true
      }
    ],
    "row_limit": 1000,
    "timeout_seconds": 30
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
  if (!bru.getVar("postgresDataSourceSlug")) {
    throw new Error("postgresDataSourceSlug not set");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("postgresRequiredQuerySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
