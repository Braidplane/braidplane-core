meta {
  name: 04e2 Execute PostgreSQL Row Limit Query
  type: http
  seq: 10.7
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{postgresDataSourceSlug}}/queries/{{postgresRowLimitQuerySlug}}/execute
  body: json
  auth: inherit
}

body:json {
  {
    "parameters": {}
  }
}

script:pre-request {
  if (!bru.getVar("postgresRowLimitQuerySlug")) {
    throw new Error("postgresRowLimitQuerySlug not set");
  }
}

tests {
  test("should return 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("should return row limit error code", function() {
    expect(res.body).to.exist;
    expect(res.body.error).to.exist;
    expect(res.body.error.code).to.equal('EXECUTION_ROW_LIMIT_EXCEEDED');
  });
}
