meta {
  name: 03 Create PostgreSQL Query
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{postgresDataSourceSlug}}/queries
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test PostgreSQL Query",
    "slug": "test-postgres-query-{{timestamp}}",
    "description": "Test query for PostgreSQL",
    "query_statement": {
      "type": "postgres",
      "sql": "SELECT 1 as test_column"
    },
    "parameters": [],
    "row_limit": 1000,
    "timeout_seconds": 30
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
  if (!bru.getVar("postgresDataSourceSlug")) {
    throw new Error("postgresDataSourceSlug not set");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("postgresQuerySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should have slug", function() {
    expect(res.body).to.have.property('slug');
  });

  test("should have query_statement", function() {
    expect(res.body).to.have.property('query_statement');
  });
}
