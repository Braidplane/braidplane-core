meta {
  name: 10 Get Missing PostgreSQL Pipeline Run
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{pipelineProjectSlug}}/environments/{{prodEnvironmentSlug}}/runs/run-missing-404
  auth: inherit
}

tests {
  test("should return 404 Not Found", function() {
    expect(res.status).to.equal(404);
  });

  test("should return pipeline run not found error code", function() {
    expect(res.body).to.exist;
    expect(res.body.error).to.exist;
    expect(res.body.error.code).to.equal('PIPELINE_RUN_NOT_FOUND');
  });

  test("should return non-empty error message", function() {
    expect(res.body.error.message).to.be.a('string');
    expect(res.body.error.message.length).to.be.greaterThan(0);
  });
}
