meta {
  name: 04e Execute PostgreSQL Query Optional Param with Default
  type: http
  seq: 10.5
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{postgresDataSourceSlug}}/queries/{{postgresOptionalDefaultQuerySlug}}/execute
  body: json
  auth: inherit
}

body:json {
  {
    "parameters": {}
  }
}

script:pre-request {
  if (!bru.getVar("postgresOptionalDefaultQuerySlug")) {
    throw new Error("postgresOptionalDefaultQuerySlug not set - run '04a2 Create PostgreSQL Query Optional Param With Default' first");
  }
}

tests {
  test("should return 200 OK when optional param with default is not provided", function() {
    expect(res.status).to.equal(200);
  });

  test("should successfully execute with default value from backend", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.payload.rows).to.be.an('array');
  });
}
