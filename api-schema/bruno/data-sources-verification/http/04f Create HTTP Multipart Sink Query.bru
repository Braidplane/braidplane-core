meta {
  name: 04f Create HTTP Multipart Sink Query
  type: http
  seq: 23.91
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{httpDataSourceSlug}}/queries
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test HTTP Multipart Sink Query",
    "slug": "test-http-multipart-sink-{{timestamp}}",
    "query_statement": {
      "type": "http",
      "method": "POST",
      "path": "/multipart-echo",
      "query_params": {},
      "headers": {},
      "body": "{{input}}"
    },
    "parameters": [],
    "row_limit": 1000,
    "timeout_seconds": 30
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());

  if (!bru.getVar("httpDataSourceSlug")) {
    throw new Error("httpDataSourceSlug not set");
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
