meta {
  name: 01 Create HTTP DS
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test HTTP Service",
    "slug": "test-http-{{timestamp}}",
    "type": "http",
    "config": {
      "base_url": "{{httpcrudUrl}}",
      "openapi_url": "{{openapiServerUrl}}",
      "openapi_fetch_timeout_seconds": 12,
      "health_path": "/health",
      "timeout_seconds": 30,
      "allow_private_hosts": true
    },
    "credentials": {
      "bearer_token": "test-token"
    }
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
  if (!bru.getEnvVar("httpcrudUrl") && !bru.getVar("httpcrudUrl")) {
    throw new Error("httpcrudUrl not set");
  }
  if (!bru.getEnvVar("openapiServerUrl") && !bru.getVar("openapiServerUrl")) {
    throw new Error("openapiServerUrl not set");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("httpDataSourceSlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should have type http", function() {
    expect(res.body.type).to.equal('http');
  });

  test("should return OpenAPI import config without credentials", function() {
    expect(res.body.config).to.exist;
    expect(res.body.config.base_url).to.equal(bru.getEnvVar("httpcrudUrl") || bru.getVar("httpcrudUrl"));
    expect(res.body.config.openapi_url).to.equal(bru.getEnvVar("openapiServerUrl") || bru.getVar("openapiServerUrl"));
    expect(res.body.config.openapi_fetch_timeout_seconds).to.equal(12);
    expect(res.body).to.not.have.property("credentials");
    expect(JSON.stringify(res.body)).to.not.contain("test-token");
  });
}
