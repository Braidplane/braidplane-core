meta {
  name: 03 Create MySQL Query
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{mysqlDataSourceSlug}}/queries
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test MySQL Query",
    "slug": "test-mysql-query-{{timestamp}}",
    "query_statement": {
      "type": "mysql",
      "sql": "SELECT 1 as test_column"
    },
    "parameters": [],
    "row_limit": 1000,
    "timeout_seconds": 30
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("mysqlQuerySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
