meta {
  name: Org Bootstrap
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/organizations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test Organization",
    "slug": "test-org-{{timestamp}}"
  }
}

script:pre-request {
  bru.deleteVar("orgSlug");
  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status !== 201) {
    bru.runner.stopExecution();
    throw new Error(`Org Bootstrap failed with status ${res.status}`);
  }

  if (!res.body?.slug) {
    bru.runner.stopExecution();
    throw new Error("Org Bootstrap did not return slug");
  }

  bru.setVar("orgSlug", res.body.slug);
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
