meta {
  name: 05 Start HubSpot OAuth Data Source Install
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/provider-connectors/hubspot/data-source-installs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "HubSpot OAuth Acceptance {{timestamp}}",
    "slug": "hubspot-oauth-{{timestamp}}",
    "type": "hubspot",
    "config": {
      "timeout_seconds": 10
    }
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status === 201) {
    const stateMatch = res.body.install.authorization_url.match(/[?&]state=([^&]+)/);
    if (!stateMatch) {
      throw new Error("HubSpot OAuth authorization URL did not include state");
    }
    bru.setVar("hubspotOAuthDataSourceSlug", res.body.data_source.slug);
    bru.setVar("hubspotOAuthState", stateMatch[1]);
  }
}

tests {
  test("should create a safe pending HubSpot OAuth data source", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data_source.type).to.equal("hubspot");
    expect(res.body.data_source.is_active).to.equal(false);
    expect(res.body.data_source.read_only).to.equal(true);
    expect(res.body.data_source.credential.kind).to.equal("oauth2_grant");
    expect(res.body.data_source.credential.status).to.equal("pending");
  });

  test("should return the provider-owned least-privilege install", function() {
    expect(res.body.install.provider).to.equal("hubspot");
    expect(res.body.install.intent).to.equal("create_grant");
    expect(res.body.install.requested_scopes).to.include("oauth");
    expect(res.body.install.requested_scopes).to.include("crm.objects.contacts.read");
    expect(res.body.install.authorization_url).to.match(/^http:\/\/localhost:\d+\/oauth\/authorize\?/);
  });

  test("should not expose credential material", function() {
    const response = JSON.stringify(res.body);
    expect(response).to.not.contain("client_secret");
    expect(response).to.not.contain("private_app_token");
    expect(response).to.not.contain("pat-na1-test-token");
    expect(response).to.not.contain("hubspot-local-refresh-token");
    expect(response).to.not.contain("encrypted_payload");
    expect(response).to.not.contain("token_hash");
  });
}
