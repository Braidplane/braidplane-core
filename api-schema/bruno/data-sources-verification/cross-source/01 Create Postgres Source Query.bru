meta {
  name: 01 Create Postgres Source Query
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{csPostgresDSSlug}}/queries
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Cross-Source Postgres Users Query",
    "slug": "cross-source-postgres-users-{{csTimestamp}}",
    "query_statement": {
      "type": "postgres",
      "sql": "SELECT id, email, full_name FROM users LIMIT 10"
    },
    "parameters": [],
    "row_limit": 1000,
    "timeout_seconds": 30
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setVar("csTimestamp", ts);

  if (!bru.getVar("csPostgresDSSlug")) {
    throw new Error("csPostgresDSSlug not set — run file 00 first");
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should return the created query slug", function() {
    expect(res.body.slug).to.be.a('string').and.not.empty;
  });
}
