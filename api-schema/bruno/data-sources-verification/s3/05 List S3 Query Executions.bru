meta {
  name: 05 List S3 Query Executions
  type: http
  seq: 44
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{s3DataSourceSlug}}/queries/{{s3ReadQuerySlug}}/executions
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("s3ReadQuerySlug")) {
    throw new Error("s3ReadQuerySlug not set");
  }
}

script:post-response {
  if (res.status === 200 && res.body.executions && res.body.executions.length > 0) {
    bru.setVar("s3ExecutionSlug", res.body.executions[0].slug);
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return at least one s3 execution record", function() {
    expect(res.body.executions).to.be.an('array').and.not.empty;

    const execution = res.body.executions[0];
    expect(execution.slug).to.be.a('string').and.not.empty;
    expect(execution.status).to.be.a('string').and.not.empty;
    expect(execution.executed_at).to.be.a('string').and.not.empty;
    expect(execution.result).to.exist;
    expect(execution.result.result_type).to.equal('s3');
    expect(execution.result.type).to.equal('s3');
  });
}
