meta {
  name: 03 Create S3 Read Query
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{s3DataSourceSlug}}/queries
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test S3 Read Query",
    "slug": "test-s3-read-{{timestamp}}",
    "query_statement": {
      "type": "s3",
      "operation": "read",
      "key": "customers.csv",
      "format": "csv",
      "has_header": true
    },
    "parameters": [],
    "row_limit": 1000,
    "timeout_seconds": 30
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
  if (!bru.getVar("s3DataSourceSlug")) {
    throw new Error("s3DataSourceSlug not set");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("s3ReadQuerySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should persist s3 read statement", function() {
    expect(res.body.query_statement.type).to.equal('s3');
    expect(res.body.query_statement.operation).to.equal('read');
    expect(res.body.query_statement.key).to.equal('customers.csv');
  });
}
