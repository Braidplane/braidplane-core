meta {
  name: 03 Missing Git Branch Data Source
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/missing-git-source/branches
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("orgSlug") && !bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set");
  }
}

tests {
  test("should return 404 Not Found", function() {
    expect(res.status).to.equal(404);
  });
}
