meta {
  name: 00 Reject Snowflake WIF Static Credentials
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Invalid Snowflake WIF",
    "slug": "invalid-snowflake-wif-{{snowflakeValidationTimestamp}}",
    "type": "snowflake",
    "config": {
      "account": "acme",
      "warehouse": "BRAIDPLANE_WH",
      "database": "ANALYTICS",
      "schema": "PUBLIC"
    },
    "credentials": {
      "auth_type": "workload_identity",
      "username": "must-not-be-accepted"
    }
  }
}

script:pre-request {
  bru.setVar("snowflakeValidationTimestamp", Date.now());
}

tests {
  test("should reject static credentials for workload identity", function() {
    expect(res.status).to.equal(400);
  });

  test("should identify forbidden static Snowflake credentials", function() {
    expect(res.body.error.code).to.equal("VALIDATION_FAILED");
    expect(res.body.error.message).to.contain('property "username" is unsupported');
  });
}
