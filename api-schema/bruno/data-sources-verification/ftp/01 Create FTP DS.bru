meta {
  name: 01 Create FTP DS
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test FTP Service",
    "slug": "test-ftp-{{timestamp}}",
    "type": "ftp",
    "config": {
      "host": "localhost",
      "port": {{ftpPort}},
      "base_path": "/",
      "connect_timeout": 30,
      "allow_private_hosts": true
    },
    "credentials": {
      "username": "braidplane",
      "password": "braidplanepass"
    }
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
  if (!bru.getEnvVar("ftpPort") && !bru.getVar("ftpPort")) {
    throw new Error("ftpPort not set");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("ftpDataSourceSlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should have type ftp", function() {
    expect(res.body.type).to.equal('ftp');
  });
}
