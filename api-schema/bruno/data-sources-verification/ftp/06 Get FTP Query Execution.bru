meta {
  name: 06 Get FTP Query Execution
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{ftpDataSourceSlug}}/queries/{{ftpQuerySlug}}/executions/{{ftpExecutionSlug}}
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("ftpExecutionSlug")) {
    throw new Error("ftpExecutionSlug not set");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return the requested execution", function() {
    expect(res.body).to.exist;
    expect(res.body.slug).to.equal(bru.getVar("ftpExecutionSlug"));
    expect(res.body.status).to.be.a('string').and.not.empty;
    expect(res.body.executed_at).to.be.a('string').and.not.empty;
    expect(res.body.result).to.exist;
    expect(res.body.result.result_type).to.equal('ftp');
    expect(res.body.result.type).to.equal('ftp');
  });
}
