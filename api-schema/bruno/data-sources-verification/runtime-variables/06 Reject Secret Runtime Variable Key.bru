meta {
  name: 06 Reject Secret Runtime Variable Key
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/organizations/{{orgSlug}}/environments/{{prodEnvironmentSlug}}/runtime-variables/api_token
  body: json
  auth: inherit
}

body:json {
  {
    "value_type": "text",
    "value": "not-a-secret",
    "protected_environment_confirmation": "{{prodEnvironmentSlug}}"
  }
}

script:pre-request {
  if (!bru.getVar("prodEnvironmentSlug")) {
    bru.setVar("prodEnvironmentSlug", "prod");
  }
}

tests {
  test("should return 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
}
