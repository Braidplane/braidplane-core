meta {
  name: 04 Execute HubSpot Query
  type: http
  seq: 17.5
}

post {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{hubspotDataSourceSlug}}/queries/{{hubspotQuerySlug}}/execute
  body: json
  auth: inherit
}

body:json {
  {
    "parameters": {}
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return successful object-row execution payload", function() {
    expect(res.body.result_type).to.equal('object_rows');
    expect(res.body.type).to.equal('hubspot');
    expect(res.body.success).to.equal(true);
    expect(res.body.payload).to.exist;
    expect(res.body.payload.object_type).to.equal('contacts');
    expect(res.body.payload.operation).to.equal('list');
    expect(res.body.payload.row_count).to.equal(2);
    expect(res.body.payload.has_more).to.equal(false);
    expect(res.body.payload.column_names).to.include.members(['hs_object_id', 'email', 'firstname', 'lastname']);
    expect(res.body.payload.rows).to.be.an('array').and.have.length(2);
    expect(res.body.payload.rows[0].email).to.equal('alice@example.com');
  });
}
