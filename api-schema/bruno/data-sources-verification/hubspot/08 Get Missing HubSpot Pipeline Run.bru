meta {
  name: 08 Get Missing HubSpot Pipeline Run
  type: http
  seq: 18.1
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{pipelineProjectSlug}}/environments/{{prodEnvironmentSlug}}/runs/run-missing-hubspot-404
  auth: inherit
}

tests {
  test("should return 404 Not Found", function() {
    expect(res.status).to.equal(404);
  });

  test("should return pipeline run not found error code", function() {
    expect(res.body.error.code).to.equal('PIPELINE_RUN_NOT_FOUND');
  });
}
