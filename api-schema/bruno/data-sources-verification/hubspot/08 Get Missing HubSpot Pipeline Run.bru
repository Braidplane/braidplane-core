meta {
  name: 08 Get Missing HubSpot Pipeline Run
  type: http
  seq: 18.1
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{pipelineProjectSlug}}/environments/{{prodEnvironmentSlug}}/runs/run-missing-hubspot-404
  auth: inherit
}

tests {
  test("should return 403 Forbidden", function() {
    expect(res.status).to.equal(403);
  });

  test("should deny access to the unresolved run", function() {
    expect(res.body.error.code).to.equal('AUTH_FORBIDDEN');
  });
}
