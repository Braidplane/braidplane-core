meta {
  name: 06 Get MongoDB Query Execution
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/data-sources/{{mongodbDataSourceSlug}}/queries/{{mongodbQuerySlug}}/executions/{{mongodbExecutionSlug}}
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("mongodbExecutionSlug")) {
    throw new Error("mongodbExecutionSlug not set");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return the requested execution", function() {
    expect(res.body).to.exist;
    expect(res.body.slug).to.equal(bru.getVar("mongodbExecutionSlug"));
    expect(res.body.status).to.be.a('string').and.not.empty;
    expect(res.body.executed_at).to.be.a('string').and.not.empty;
    expect(res.body.result).to.exist;
    expect(res.body.result.result_type).to.equal('mongodb');
    expect(res.body.result.type).to.equal('mongodb');
  });
}