meta {
  name: Update user password
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/users/profile/password
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "{{userPassword}}",
    "new_password": "{{nextUserPassword}}"
  }
}

script:pre-request {
  const currentPassword = bru.getVar("userPassword");
  if (!currentPassword) {
    throw new Error("userPassword not set - run 'Create a session' first.");
  }

  const csrfToken = bru.getVar("csrfToken") || bru.getEnvVar("csrfToken");
  if (!csrfToken) {
    throw new Error("csrfToken not set - run 'Create a session' first.");
  }

  const nextUserPassword = `ChangedPass${Date.now()}!`;
  bru.setVar("nextUserPassword", nextUserPassword);
  req.setHeader("X-CSRF-Token", csrfToken);
}

script:post-response {
  if (res.status === 204) {
    bru.setVar("userPassword", bru.getVar("nextUserPassword"));
    // Password changes invalidate the old session before the following MFA flow.
    await bru.runRequest('Create a session.bru');
  }
}

tests {
  test("should return 204 No Content", function() {
    expect(res.status).to.equal(204);
    bru.setVar("userPassword", bru.getVar("nextUserPassword"));
  });

  test("should have empty body", function() {
    expect(res.body).to.be.empty;
  });
}

example {
  name: 204 Response
  description: Password successfully changed

  request: {
    url: {{baseUrl}}/users/profile/password
    method: PUT
    mode: json
    body:json: {
      {
        "current_password": "SecurePass123!",
        "new_password": "NewSecurePass123!"
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
