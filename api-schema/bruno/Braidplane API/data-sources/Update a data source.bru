meta {
  name: Update a data source
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug
  body: json
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  ds_slug: {{dataSourceSlug}}
}

body:json {
  {
    "name": "Updated PostgreSQL Database",
    "config": {
      "host": "localhost",
      "port": {{postgresPort}},
      "database": "braidplane",
      "ssl_mode": "disable",
      "connect_timeout": 10,
      "allow_private_hosts": true
    }
  }
}

script:pre-request {
  // Ensure we have orgSlug and dataSourceSlug from previous requests
  if (!bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set - run 'Create an organization' first");
  }
  if (!bru.getVar("dataSourceSlug")) {
    throw new Error("dataSourceSlug not set - run 'Create a data source' first");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return JSON", function() {
    expect(res.headers['content-type']).to.include('application/json');
  });

  test("should return updated data source", function() {
    expect(res.body).to.be.an('object');
    expect(res.body).to.have.property('slug');
    expect(res.body).to.have.property('name');
    expect(res.body).to.have.property('type');
    expect(res.body).to.have.property('config');
    // Schema may be present if introspected, or null if not
    expect(res.body).to.have.property('schema');
  });

  test("should have updated name", function() {
    expect(res.body.name).to.equal('Updated PostgreSQL Database');
  });

  test("should have updated config", function() {
    expect(res.body.config.database).to.equal('braidplane');
    expect(res.body.config.connect_timeout).to.equal(10);
    expect(res.body.config.port).to.equal(Number(bru.getEnvVar('postgresPort')));
  });

  test("should not change slug", function() {
    expect(res.body.slug).to.equal(bru.getVar("dataSourceSlug"));
  });

  test("should not return credentials", function() {
    expect(res.body).to.not.have.property('credentials');
  });

  test("updated_at should be a valid timestamp", function() {
    expect(Number.isNaN(Date.parse(res.body.updated_at))).to.equal(false);
  });
}
