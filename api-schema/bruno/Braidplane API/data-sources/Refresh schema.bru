meta {
  name: Refresh schema
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/schema
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  ds_slug: {{dataSourceSlug}}
}

script:pre-request {
  // Ensure we have orgSlug and dataSourceSlug from previous requests
  if (!bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set - run 'Create an organization' first");
  }
  if (!bru.getVar("dataSourceSlug")) {
    throw new Error("dataSourceSlug not set - run 'Create a data source' first");
  }
}

tests {
  test("should return 202 Accepted", function() {
    expect(res.status).to.equal(202);
  });

  test("should return JSON", function() {
    expect(res.headers['content-type']).to.include('application/json');
  });

  test("should return schema import state", function() {
    expect(res.body).to.be.an('object');
    expect(res.body.data_source_slug).to.equal(bru.getVar('dataSourceSlug'));
    expect(res.body.schema_status).to.equal('importing');
    expect(res.body.enqueued).to.be.a('boolean');

    if (res.body.enqueued) {
      expect(res.body.job).to.be.an('object');
      expect(res.body.job.kind).to.equal('data_source_schema_import');
      expect(res.body.job.queue).to.equal('data_source_schema_import');
      expect(res.body.job.state).to.equal('queued');
    } else {
      expect(res.body.job).to.not.exist;
    }
  });
}
