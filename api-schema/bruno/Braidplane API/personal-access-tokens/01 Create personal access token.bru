meta {
  name: 01 Create personal access token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/profile/personal-access-tokens
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Hard delete PAT {{patHardDeleteTimestamp}}",
    "slug": "{{patHardDeleteSlug}}"
  }
}

script:pre-request {
  const timestamp = Date.now();
  bru.setVar("patHardDeleteTimestamp", timestamp);
  bru.setVar("patHardDeleteSlug", `hard-delete-pat-${timestamp}`);
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should return raw token once and safe metadata", function() {
    expect(res.body).to.have.property("slug", bru.getVar("patHardDeleteSlug"));
    expect(res.body).to.have.property("token");
    expect(res.body.token).to.be.a("string").and.not.be.empty;
    expect(res.body).to.have.property("token_prefix");
    expect(res.body).to.have.property("expires_at", null);
    expect(res.body).to.not.have.property("token_hash");
    bru.setVar("patHardDeleteToken", res.body.token);
  });
}
