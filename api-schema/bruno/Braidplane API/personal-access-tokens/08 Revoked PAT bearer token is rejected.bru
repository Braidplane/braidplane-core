meta {
  name: 08 Revoked PAT bearer token is rejected
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/users/profile
  body: none
  auth: inherit
}

script:pre-request {
  req.setHeader("Authorization", `Bearer ${bru.getVar("patHardDeleteToken")}`);
  req.setHeader("Cookie", "");
}

tests {
  test("revoked PAT bearer token should return 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
}
