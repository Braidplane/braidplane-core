meta {
  name: 09 Rotated bearer token can access org endpoint
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/organizations/:slug/data-sources
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
}

script:pre-request {
  req.setHeader("Authorization", `Bearer ${bru.getVar("apiKeyTokenRotated")}`);
  req.setHeader("Cookie", "");
}

tests {
  test("rotated bearer token should authorize with API key role permissions", function() {
    expect(res.status).to.equal(200);
  });
}
