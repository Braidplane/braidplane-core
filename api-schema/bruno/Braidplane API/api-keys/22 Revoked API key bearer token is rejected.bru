meta {
  name: 22 Revoked API key bearer token is rejected
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/organizations/:slug/data-sources
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
}

script:pre-request {
  req.setHeader("Authorization", `Bearer ${bru.getVar("apiKeyHardDeleteToken")}`);
  req.setHeader("Cookie", "");
}

tests {
  test("revoked API key bearer token should return 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
}
