meta {
  name: Reset password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: inherit
}

body:json {
  {
    "token": "{{passwordResetToken}}",
    "password": "{{nextUserPassword}}"
  }
}

script:pre-request {
  const axios = require('axios');

  const userEmail = bru.getVar("userEmail");
  if (!userEmail) {
    throw new Error("userEmail not found. Run 'Create a user' first.");
  }

  const nextUserPassword = `ResetPass${Date.now()}!`;
  bru.setVar("nextUserPassword", nextUserPassword);

  const {emailText, resetToken} = require('./auth-email.cjs');
  const content = await emailText(axios, bru.getEnvVar("mailpitUrl"), userEmail, /reset-password/);
  bru.setVar("passwordResetToken", resetToken(content, bru.getEnvVar("frontendUrl")));
}

tests {
  test("should return 204 No Content", function() {
    expect(res.status).to.equal(204);
  });

  test("should have empty body", function() {
    expect(res.body).to.be.empty;
  });

  bru.setVar("userPassword", bru.getVar("nextUserPassword"));
}

example {
  name: 204 Response
  description: Password successfully reset

  request: {
    url: {{baseUrl}}/auth/password/reset
    method: POST
    mode: json
    body:json: {
      {
        "token": "reset-token-abc123",
        "password": "NewSecurePass123!"
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}