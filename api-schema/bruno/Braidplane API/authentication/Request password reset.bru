meta {
  name: Request password reset
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/password/forgot
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

script:pre-request {
  const userEmail = bru.getVar("userEmail");

  if (!userEmail) {
    throw new Error("userEmail not found. Run 'Create a user' first.");
  }
}

tests {
  test("should return 204 No Content", function() {
    expect(res.status).to.equal(204);
  });

  test("should have empty body", function() {
    expect(res.body).to.be.empty;
  });
}

example {
  name: 204 Response
  description: Password reset request accepted

  request: {
    url: {{baseUrl}}/auth/password/forgot
    method: POST
    mode: json
    body:json: {
      {
        "email": "john.doe@example.com"
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}