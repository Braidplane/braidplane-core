meta {
  name: Delete a role
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/organizations/:slug/roles/:role_slug
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  role_slug: {{roleSlug}}
}

tests {
  test("should return 204 No Content", function() {
    expect(res.status).to.equal(204);
  });
}

example {
  name: 204 Response
  description: Role deleted

  request: {
    url: {{baseUrl}}/organizations/:slug/roles/:role_slug
    method: DELETE
    mode: none
    params:path: {
      slug:
      role_slug:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Role not found

  request: {
    url: {{baseUrl}}/organizations/:slug/roles/:role_slug
    method: DELETE
    mode: none
    params:path: {
      slug:
      role_slug:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "",
            "message": "",
            "validation_errors": [
              {
                "field": "",
                "code": "",
                "message": "",
                "details": {}
              }
            ],
            "request_id": ""
          }
        }
      '''
    }
  }
}
