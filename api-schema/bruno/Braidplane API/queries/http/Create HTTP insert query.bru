meta {
  name: Create HTTP insert query
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/queries
  body: json
  auth: inherit
}

params:path {
  slug: {{httpOrgSlug}}
  ds_slug: {{httpDataSourceSlug}}
}

body:json {
  {
    "name": "Create item via HTTP API",
    "slug": "create-http-item-{{timestamp}}",
    "description": "HTTP POST request creating an item with body parameters",
    "query_statement": {
      "type": "http",
      "method": "POST",
      "path": "/items",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "{{item_name}}",
        "status": "{{item_status}}"
      }
    },
    "parameters": [
      {
        "slug": "item-name",
        "name": "item_name",
        "data_type": "text",
        "is_required": true
      },
      {
        "slug": "item-status",
        "name": "item_status",
        "data_type": "text",
        "is_required": true,
        "default_value": "active"
      }
    ],
    "row_limit": 1,
    "timeout_seconds": 30
  }
}

script:pre-request {
  if (!bru.getVar("httpOrgSlug")) {
    throw new Error("httpOrgSlug not set - run 'Create an organization' first");
  }

  if (!bru.getVar("httpDataSourceSlug")) {
    throw new Error("httpDataSourceSlug not set - run a data source create request first");
  }

  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("httpInsertQuerySlug", res.body.slug);
    bru.setVar("querySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
