meta {
  name: Create HTTP query
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/queries
  body: json
  auth: inherit
}

params:path {
  slug: {{httpOrgSlug}}
  ds_slug: {{httpDataSourceSlug}}
}

body:json {
  {
    "name": "List items by status from HTTP API",
    "slug": "list-http-items-{{timestamp}}",
    "description": "HTTP GET request with query parameters",
    "query_statement": {
      "type": "http",
      "method": "GET",
      "path": "/items",
      "query_params": {
        "status": "{{status}}"
      },
      "headers": {
        "X-Request-Source": "braidplane"
      }
    },
    "parameters": [
      {
        "slug": "status",
        "name": "status",
        "data_type": "text",
        "is_required": false,
        "default_value": "active"
      }
    ],
    "row_limit": 1,
    "timeout_seconds": 30
  }
}

script:pre-request {
  if (!bru.getVar("httpOrgSlug")) {
    throw new Error("httpOrgSlug not set - run 'Create an organization' first");
  }

  if (!bru.getVar("httpDataSourceSlug")) {
    throw new Error("httpDataSourceSlug not set - run a data source create request first");
  }

  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("httpSearchQuerySlug", res.body.slug);
    bru.setVar("querySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should return query with parameters", function() {
    expect(res.body).to.have.property("parameters");
    expect(res.body.parameters).to.be.an("array");
    expect(res.body.parameters).to.have.lengthOf(1);
  });
}
