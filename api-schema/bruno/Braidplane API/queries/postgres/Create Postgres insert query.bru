meta {
  name: Create Postgres insert query
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/queries
  body: json
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  ds_slug: {{postgresDataSourceSlug}}
}

body:json {
  {
    "name": "Insert user into Postgres",
    "slug": "insert-user-pg-{{timestamp}}",
    "description": "PostgreSQL insert query with parameterized values",
    "query_statement": {
      "type": "postgres",
      "sql": "INSERT INTO users (email, full_name, age, is_active) VALUES ({{email}}, {{full_name}}, {{age}}, {{is_active}}) RETURNING id, email, full_name, age, is_active"
    },
    "parameters": [
      {
        "slug": "email",
        "name": "email",
        "data_type": "text",
        "is_required": true
      },
      {
        "slug": "full-name",
        "name": "full_name",
        "data_type": "text",
        "is_required": true
      },
      {
        "slug": "age",
        "name": "age",
        "data_type": "integer",
        "is_required": true
      },
      {
        "slug": "is-active",
        "name": "is_active",
        "data_type": "boolean",
        "is_required": true,
        "default_value": "true"
      }
    ],
    "row_limit": 1,
    "timeout_seconds": 30
  }
}

script:pre-request {
  if (!bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set - run 'Create an organization' first");
  }

  if (!bru.getVar("postgresDataSourceSlug")) {
    throw new Error("postgresDataSourceSlug not set - run a data source create request first");
  }

  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("postgresInsertQuerySlug", res.body.slug);
    bru.setVar("querySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
