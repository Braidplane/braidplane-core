meta {
  name: Update a query
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/queries/:query_slug
  body: json
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  ds_slug: {{dataSourceSlug}}
  query_slug: {{querySlug}}
}

body:json {
  {
    "name": "Updated query name",
    "description": "Updated via Bruno generic query endpoint",
    "query_statement": {
      "type": "postgres",
      "sql": "SELECT id, email FROM users WHERE is_active = {{is_active}} LIMIT {{limit}}"
    },
    "parameters": [
      {
        "slug": "is-active",
        "name": "is_active",
        "data_type": "boolean",
        "is_required": true,
        "default_value": "true"
      },
      {
        "slug": "limit",
        "name": "limit",
        "data_type": "integer",
        "is_required": false,
        "default_value": "10"
      }
    ],
    "row_limit": 100,
    "timeout_seconds": 30
  }
}

script:pre-request {
  if (!bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set - run 'Create an organization' first");
  }

  if (!bru.getVar("dataSourceSlug")) {
    throw new Error("dataSourceSlug not set - run a data source create request first");
  }

  if (!bru.getVar("querySlug")) {
    throw new Error("querySlug not set - run a query create request first");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return updated query", function() {
    expect(res.body).to.have.property("slug", bru.getVar("querySlug"));
    expect(res.body).to.have.property("name", "Updated query name");
  });
}
