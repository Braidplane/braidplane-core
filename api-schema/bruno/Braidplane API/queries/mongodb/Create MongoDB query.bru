meta {
  name: Create MongoDB query
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/queries
  body: json
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  ds_slug: {{mongoDataSourceSlug}}
}

body:json {
  {
    "name": "Find users in MongoDB",
    "slug": "find-mongo-users-{{timestamp}}",
    "description": "MongoDB find query with filter parameters",
    "query_statement": {
      "type": "mongodb",
      "collection": "users",
      "operation": "find",
      "filter": {
        "email": "{{email}}"
      },
      "sort": {
        "createdAt": -1
      }
    },
    "parameters": [
      {
        "slug": "email",
        "name": "email",
        "data_type": "text",
        "is_required": true
      }
    ],
    "row_limit": 100,
    "timeout_seconds": 30
  }
}

script:pre-request {
  if (!bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set - run 'Create an organization' first");
  }

  if (!bru.getVar("mongoDataSourceSlug")) {
    throw new Error("mongoDataSourceSlug not set - run a data source create request first");
  }

  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("mongodbSearchQuerySlug", res.body.slug);
    bru.setVar("querySlug", res.body.slug);
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should return query with parameters", function() {
    expect(res.body).to.have.property("parameters");
    expect(res.body.parameters).to.be.an("array");
    expect(res.body.parameters).to.have.lengthOf(1);
  });
}
