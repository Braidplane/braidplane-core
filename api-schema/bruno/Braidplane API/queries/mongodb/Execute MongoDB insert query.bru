meta {
  name: Execute MongoDB insert query
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/organizations/:slug/data-sources/:ds_slug/queries/:query_slug/execute
  body: json
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  ds_slug: {{mongoDataSourceSlug}}
  query_slug: {{mongodbInsertQuerySlug}}
}

body:json {
  {
    "parameters": {
      "email": "new.mongo.user.{{timestamp}}@example.com",
      "full_name": "Inserted Mongo User"
    }
  }
}

script:pre-request {
  if (!bru.getVar("orgSlug")) {
    throw new Error("orgSlug not set - run 'Create an organization' first");
  }

  if (!bru.getVar("mongoDataSourceSlug")) {
    throw new Error("mongoDataSourceSlug not set - run a data source create request first");
  }

  if (!bru.getVar("mongodbInsertQuerySlug")) {
    throw new Error("mongodbInsertQuerySlug not set - run 'Create MongoDB insert query' first");
  }

  bru.setVar("timestamp", Date.now());
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return MongoDB execution result", function() {
    expect(res.body).to.have.property("result_type", "mongodb");
    expect(res.body).to.have.property("type", "mongodb");
    expect(res.body).to.have.property("success", true);
    expect(res.body.payload).to.have.property("operation_type", "insert_one");
  });
}
