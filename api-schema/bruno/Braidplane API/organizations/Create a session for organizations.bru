meta {
  name: Create a session for organizations
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sessions
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:pre-request {
  const userEmail = bru.getEnvVar("userEmail") || bru.getVar("userEmail");
  const userPassword = bru.getEnvVar("userPassword") || bru.getVar("userPassword");

  if (!userEmail || !userPassword) {
    throw new Error("userEmail/userPassword not set - run the seeded organizations Bruno task");
  }

  bru.setVar("userEmail", userEmail);
  bru.setVar("userPassword", userPassword);
}

script:post-response {
  if (res.status !== 200) {
    bru.runner.stopExecution();
    throw new Error(`Create session failed with status ${res.status}`);
  }

  const setCookie = res.headers['set-cookie'] || res.headers['Set-Cookie'];
  if (!setCookie) {
    bru.runner.stopExecution();
    throw new Error("set-cookie header not found - session creation may have failed");
  }
  const cookies = Array.isArray(setCookie) ? setCookie : [setCookie];
  const sessionEntry = [...cookies].reverse().find(c => /session/i.test(c.split(';')[0]) && !/Max-Age=0/i.test(c) && c.split(';')[0].split('=').slice(1).join('=') !== "");
  if (!sessionEntry) {
    bru.runner.stopExecution();
    throw new Error(`session cookie not found in set-cookie: ${JSON.stringify(cookies)}`);
  }
  const cookiePart = sessionEntry.split(';')[0];
  bru.setVar("legacySessionCookie", cookiePart);

  const csrfResponse = await bru.sendRequest({
    method: "GET",
    url: `${bru.getEnvVar("baseUrl")}/organizations`,
    headers: {
      Cookie: cookiePart
    }
  });
  const csrfToken = csrfResponse.headers['x-csrf-token'] || csrfResponse.headers['X-CSRF-Token'];
  if (!csrfToken) {
    bru.runner.stopExecution();
    throw new Error("CSRF token not found");
  }
  bru.setVar("csrfToken", csrfToken);
  const profileResponse = await bru.sendRequest({
    method: "GET",
    url: `${bru.getEnvVar("baseUrl")}/users/profile`,
    headers: { Cookie: cookiePart }
  });
  if (profileResponse.status !== 200) throw new Error("Profile read failed after sign in");
  bru.setVar("authenticatedUserSlug", profileResponse.data.slug);
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should set session cookie", function() {
    const setCookie = res.headers['set-cookie'] || res.headers['Set-Cookie'];
    expect(setCookie).to.exist;
    expect(setCookie).to.match(/session/i);
  });
}
