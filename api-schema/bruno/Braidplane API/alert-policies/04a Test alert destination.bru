meta {
  name: 04a Test alert destination
  type: http
  seq: 4.1
}

post {
  url: {{baseUrl}}/organizations/:slug/alert-destinations/:alert_destination_slug/test
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  alert_destination_slug: {{alertDestinationSlug}}
}

tests {
  test("should return 202 Accepted", function() {
    expect(res.status).to.equal(202);
  });

  test("should return safe test acceptance metadata", function() {
    expect(res.body.status).to.equal("accepted");
    expect(res.body.destination_slug).to.equal(bru.getVar("alertDestinationSlug"));
    expect(res.body.destination_type).to.equal("email");
    expect(res.body.recipient_count).to.equal(1);
    expect(res.body.diagnostics_persisted).to.equal(false);
    expect(res.body.enqueued_jobs).to.be.an("array").with.lengthOf(1);
    expect(res.body.enqueued_jobs[0]).to.deep.equal({
      kind: "email_send",
      queue: "email",
      state: "queued"
    });
    expect(res.body).to.not.have.property("credential_slug");
    expect(res.body).to.not.have.property("secret_config");
    expect(JSON.stringify(res.body)).to.not.contain(bru.getVar("updatedAlertDestinationRecipient"));
  });
}
