meta {
  name: 10 Deleted alert policy is absent
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/organizations/:slug/alert-policies/:alert_policy_slug
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  alert_policy_slug: {{alertPolicySlug}}
}

tests {
  test("deleted alert policy should return 403 Forbidden", function() {
    expect(res.status).to.equal(403);
  });

  test("deleted alert policy should not be retrievable", function() {
    expect(res.body.error.code).to.equal("AUTH_FORBIDDEN");
    expect(res.body.error.message).to.include("permission");
  });
}
