meta {
  name: 12 Deleted alert destination is absent
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/organizations/:slug/alert-destinations/:alert_destination_slug
  body: none
  auth: inherit
}

params:path {
  slug: {{orgSlug}}
  alert_destination_slug: {{alertDestinationSlug}}
}

tests {
  test("deleted alert destination should return 404 Not Found", function() {
    expect(res.status).to.equal(404);
  });

  test("deleted alert destination should not be retrievable", function() {
    expect(res.body.error.code).to.equal("ALERT_DESTINATION_NOT_FOUND");
    expect(res.body.error.message).to.equal("alert destination not found");
  });
}
