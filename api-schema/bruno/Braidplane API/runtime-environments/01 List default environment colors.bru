meta {
  name: 01 List default environment colors
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/organizations/{{orgSlug}}/environments?limit=50&order=asc
  auth: inherit
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should include default environment colors", function() {
    expect(res.body.environments).to.be.an("array");
    const bySlug = new Map(res.body.environments.map((environment) => [environment.slug, environment]));

    expect(bySlug.get("dev")).to.exist;
    expect(bySlug.get("dev").name).to.equal("Development");
    expect(bySlug.get("dev").color).to.equal("blue");

    expect(bySlug.get("stg")).to.exist;
    expect(bySlug.get("stg").name).to.equal("Staging");
    expect(bySlug.get("stg").color).to.equal("amber");

    expect(bySlug.get("prod")).to.exist;
    expect(bySlug.get("prod").name).to.equal("Production");
    expect(bySlug.get("prod").protected).to.equal(true);
    expect(bySlug.get("prod").color).to.equal("red");
  });
}
