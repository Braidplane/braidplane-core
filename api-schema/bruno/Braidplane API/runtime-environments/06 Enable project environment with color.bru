meta {
  name: 06 Enable project environment with color
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/organizations/{{orgSlug}}/projects/{{projectSlug}}/environments/{{runtimeEnvironmentSlug}}
  body: json
  auth: inherit
}

body:json {
  {
    "is_default": false,
    "protected_environment_confirmation": "{{runtimeEnvironmentSlug}}"
  }
}

script:pre-request {
  if (!bru.getVar("runtimeEnvironmentSlug")) {
    bru.runner.stopExecution();
    throw new Error("runtimeEnvironmentSlug not set - run '02 Create custom environment with color' first");
  }
  if (!bru.getVar("projectSlug")) {
    bru.runner.stopExecution();
    throw new Error("projectSlug not set - run task bruno-environments");
  }
}

script:post-response {
  if (res.status !== 200) {
    bru.runner.stopExecution();
    throw new Error(`Enable project environment failed with status ${res.status}`);
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should include environment color in project environment response", function() {
    expect(res.body.environment_slug).to.equal(bru.getVar("runtimeEnvironmentSlug"));
    expect(res.body.environment_name).to.equal(bru.getVar("runtimeEnvironmentUpdatedName"));
    expect(res.body.environment_description).to.equal(bru.getVar("runtimeEnvironmentUpdatedDescription"));
    expect(res.body.environment_color).to.equal("purple");
    expect(res.body.environment_protected).to.equal(true);
    expect(res.body.is_default).to.equal(false);
  });
}
