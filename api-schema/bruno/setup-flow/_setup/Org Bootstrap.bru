meta {
  name: Org Bootstrap
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/organizations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test Organization",
    "slug": "test-org-{{timestamp}}"
  }
}

script:pre-request {
  req.setHeader("X-CSRF-Token", bru.getVar("csrfToken"));
  bru.deleteVar("orgSlug");
  bru.setVar("timestamp", Date.now());
}

script:post-response {
  if (res.status !== 201) {
    bru.runner.stopExecution();
    throw new Error(`Org Bootstrap failed with status ${res.status}`);
  }

  if (!res.body?.slug) {
    bru.runner.stopExecution();
    throw new Error("Org Bootstrap did not return slug");
  }

  bru.setVar("orgSlug", res.body.slug);
}

tests {
  test("should return 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("should return organization with slug", function() {
    expect(res.body).to.have.property('slug');
  });

  test("should have timestamps", function() {
    expect(res.body.created_at).to.exist;
    expect(res.body.updated_at).to.exist;
  });
}
