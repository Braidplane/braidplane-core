# Test-only tracer: copies the already-built local application binaries unchanged.
FROM braidplane-selfhost-acceptance-backend:local AS backend
FROM braidplane-selfhost-acceptance-cli:local AS cli
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
RUN apt-get update \
    && apt-get install -y --no-install-recommends strace=6.8-0ubuntu2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=backend /braidplane-server /braidplane-server
COPY --from=cli /braidplane /braidplane
ENV HOME=/tmp
USER 65532:65532
ENTRYPOINT ["strace", "-f", "-qq", "-s", "0", "-e", "trace=connect"]
